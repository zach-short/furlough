---
// The app's Home screen as a phone you can use: `HeroPager`'s strip of status hourglasses
// pages between the apps that have rules, and `HalfTabBar` — the same floating capsule the
// app carries at the bottom of the screen — switches between Rules and the Anchor.
//
// `TARGETS` below is the only place a rule is written down. The rows are rendered from it
// here, and the same rules go to the client as JSON, where each page's beat is derived the
// way `HomeView.line(now:)` derives its own: eyebrow, big countdown and sub from the status.
// A row and the page it turns to therefore cannot disagree about what a rule says.

const anchorGlyph =
  '<circle cx="40" cy="15" r="10.5"/><path d="M40 26v56M17 38h46M12 58c0 16 12 26 28 26s28-10 28-26"/><path d="M7 41L2 59l16 9zM73 41l5 18-16 9z" fill="currentColor" stroke-width="2"/>';

const IG =
  '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.6"/><circle cx="12" cy="12" r="4.6"/><circle cx="17.5" cy="6.5" r="1.35" fill="#fff" stroke="none"/></svg>';
const YT =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#f00" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"/><path fill="#fff" d="M9.55 15.57V8.43L15.82 12z"/></svg>';
const RD =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><g fill="#fff"><circle cx="16.4" cy="3.2" r="2"/><path d="M12.05 10.1 13.6 4a.75.75 0 0 1 .9-.55l1.6.35-.3 1.42-1-.22-1.35 5.32z"/><ellipse cx="12" cy="15.4" rx="7.5" ry="6.2"/><circle cx="3.1" cy="12.6" r="2.8"/><circle cx="20.9" cy="12.6" r="2.8"/></g><g fill="#ff4500"><circle cx="9" cy="14.6" r="1.6"/><circle cx="15" cy="14.6" r="1.6"/></g><path d="M8.8 17.9a4.5 4.5 0 0 0 6.4 0" fill="none" stroke="#ff4500" stroke-width="1.4" stroke-linecap="round"/></svg>';
const TT =
  '<svg viewBox="-2 -2 28 28" aria-hidden="true"><g><path fill="#25f4ee" transform="translate(-1.3 -1)" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.84-2.48V9.66a5.66 5.66 0 1 0 4.93 5.61V8.99a7.3 7.3 0 0 0 4.27 1.37V7.27a4.29 4.29 0 0 1-3.21-1.45"/><path fill="#fe2c55" transform="translate(1.3 1)" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.84-2.48V9.66a5.66 5.66 0 1 0 4.93 5.61V8.99a7.3 7.3 0 0 0 4.27 1.37V7.27a4.29 4.29 0 0 1-3.21-1.45"/><path fill="#fff" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.84-2.48V9.66a5.66 5.66 0 1 0 4.93 5.61V8.99a7.3 7.3 0 0 0 4.27 1.37V7.27a4.29 4.29 0 0 1-3.21-1.45"/></g></svg>';

// `Half.icon`: the two SF Symbols the app's bottom navbar uses, drawn rather than fetched.
const HALVES = [
  { key: 'rules', title: 'Rules',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.4 3h11.2M6.4 21h11.2M8.4 3v3.1c0 2 1.2 3.5 3.6 5.9 2.4-2.4 3.6-3.9 3.6-5.9V3M8.4 21v-3.1c0-2 1.2-3.5 3.6-5.9 2.4 2.4 3.6 3.9 3.6 5.9V21"/></svg>' },
  { key: 'anchor', title: 'Anchor',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M8.2 8.6a4.8 4.8 0 0 1 0 6.8M12.3 5.7a9 9 0 0 1 0 12.6M16.4 2.9a13.2 13.2 0 0 1 0 18.2"/></svg>' },
];

interface Rule {
  /** Minutes of the day, the way `Rule.Window` stores them. */
  open: number;
  close: number;
  /** Minutes a day. */
  budget: number;
}

interface Target {
  key: string;
  name: string;
  cls: string;
  style?: string;
  icon: string;
  /** `null` is the always-blocked rule: no window and no budget. */
  rule: Rule | null;
  /** Written out only where a window cannot say it; otherwise the rule writes this line. */
  detail?: string;
  /** Tonight's half hour goes into this one, so its budget drains with its window and its
      five-minute warning fires. The others are open or closed but untouched. */
  spends?: boolean;
  /** Also in the Anchor's list, so every line about the Anchor counts these rather than
      claiming a number nothing on screen backs up. */
  anchored?: boolean;
  section: string;
}

/** "8:00 PM", the way `TimeFormat.until` prints it. */
const ampm = (minute: number) => {
  const h = Math.floor(minute / 60) % 24;
  const m = minute % 60;
  return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
};
/** "8:00–8:30 PM": one meridiem when the window does not cross noon or midnight. */
const span = (a: number, b: number) =>
  (Math.floor(a / 60) < 12) === (Math.floor(b / 60) < 12)
    ? `${ampm(a).replace(/ [AP]M$/, '')}–${ampm(b)}`
    : `${ampm(a)}–${ampm(b)}`;

const TARGETS: Target[] = [
  { key: 'instagram', name: 'Instagram', cls: 'ig', icon: IG, section: 'Tonight', spends: true, anchored: true,
    rule: { open: 20 * 60, close: 20 * 60 + 30, budget: 30 } },
  { key: 'youtube', name: 'YouTube', cls: 'yt', style: '--c: #fff', icon: YT, section: 'Tonight', anchored: true,
    rule: { open: 20 * 60, close: 22 * 60, budget: 30 } },
  { key: 'reddit', name: 'Reddit', cls: 'rd', style: '--c: #ff4500', icon: RD, section: 'Tonight', anchored: true,
    rule: { open: 21 * 60, close: 22 * 60, budget: 20 } },
  { key: 'tiktok', name: 'TikTok', cls: 'tt', style: '--c: #000', icon: TT, section: 'Always blocked',
    rule: null, detail: 'Social · no windows' },
];

const rows = TARGETS.map((t) => ({
  ...t,
  detail: t.detail ?? `${span(t.rule!.open, t.rule!.close)} · ${t.rule!.budget} min`,
  // The first frame, before the script has a clock: the evening opens a minute shy of 8.
  chip: t.rule ? ampm(t.rule.open) : 'all day',
  tone: t.rule ? 'amber' : 'grey',
}));
const SECTIONS = ['Tonight', 'Always blocked'].map((title) => ({
  title,
  rows: rows.filter((r) => r.section === title),
}));
const HELD = rows.filter((r) => r.anchored);

/** What the script needs of the table: rules, and the copy only `ampm` knows how to write. */
const DATA = rows.map((r) => ({
  key: r.key,
  name: r.name,
  detail: r.detail,
  ...(r.rule
    ? { open: r.rule.open, close: r.rule.close, budget: `${r.rule.budget} min`,
        opensAt: ampm(r.rule.open), until: ampm(r.rule.close), spends: !!r.spends }
    : { blocked: true }),
}));
const ANCHOR = { count: HELD.length, names: HELD.map((h) => h.name).join(', ') };
---

<div class="stack">
  <div class="phone" data-hero>
    <div class="statusbar" aria-hidden="true"><span class="mono" data-hero-clock>7:59</span><span class="signal"><i></i><i></i><i></i><i></i></span></div>
    <div class="toolbar" aria-hidden="true">
      <span class="left">
        <span class="glass icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></span>
        <span class="glass icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.2"/><path d="M9.6 9.4a2.5 2.5 0 1 1 2.9 2.7v1.4"/><circle cx="12.4" cy="16.8" r="0.9" fill="currentColor" stroke="none"/></svg></span>
      </span>
      <span class="glass icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
    </div>

    <!-- The page the strip turns. A tabpanel now that the strip and the tab bar select it, so
         it is no longer an image of a screen; `pan-y` keeps a finger scrolling the site past it. -->
    <div
      class="hero-page"
      id="hero-panel"
      data-hero-panel
      role="tabpanel"
      tabindex="0"
      aria-labelledby="hero-tab-instagram"
    >
      <canvas class="glass-canvas" width="96" height="128" data-hero-glass aria-hidden="true"></canvas>
      <div class="text" data-hero-text>
        <div class="eyebrow amber" data-hero-eyebrow>Next window</div>
        <div class="name" data-hero-name>Instagram</div>
        <div class="count mono" data-hero-count>1:00</div>
        <div class="sub" data-hero-sub>opens at 8:00 PM · 30 min a day</div>
      </div>
    </div>

    <!-- `HeroPager`'s indicator: one status hourglass per app with a rule, and it wraps. -->
    <div class="indicator" role="tablist" aria-label="Apps with rules" data-strip>
      {rows.map((r, i) => (
        <button
          type="button"
          class="dot"
          role="tab"
          id={`hero-tab-${r.key}`}
          data-tab={r.key}
          aria-controls="hero-panel"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <canvas width="11" height="15" data-tab-glass={r.key} aria-hidden="true"></canvas>
          <span class="sr">{r.name}</span>
        </button>
      ))}
    </div>

    <!-- The other end of the same pager: every row is a page, and the one showing is marked. -->
    <div class="list" data-today-list>
      {SECTIONS.map((section) => (
        <Fragment>
          <div class="eyebrow seclabel">{section.title}</div>
          <div class="card rows">
            {section.rows.map((r) => (
              <button type="button" class="row" data-row={r.key} aria-controls="hero-panel">
                <span class={`tile ${r.cls}`} style={r.style} set:html={r.icon} />
                <span class="who"><span class="n">{r.name}</span><span class="r">{r.detail}</span></span>
                <span class={`chip ${r.tone}`} data-row-chip={r.key}>
                  <canvas width="12" height="16" data-row-glass={r.key} aria-hidden="true"></canvas>
                  <span data-row-text>{r.chip}</span>
                </span>
              </button>
            ))}
          </div>
        </Fragment>
      ))}
    </div>

    <!-- The Anchor's half: the same apps, held together rather than each on its own rule. -->
    <div class="list anchor-list" data-anchor-list aria-hidden="true" hidden>
      <div class="eyebrow seclabel">In the Anchor · {ANCHOR.count} apps</div>
      <div class="card rows">
        {HELD.map((r) => (
          <div class="row">
            <span class={`tile ${r.cls}`} style={r.style} set:html={r.icon} />
            <span class="who"><span class="n">{r.name}</span><span class="r">Held with the list</span></span>
            <span class="chip achip"><span class="a-ready">ready</span><span class="a-held">held</span></span>
          </div>
        ))}
      </div>
      <div class="aact">
        <span class="glass prominent abtn"><svg viewBox="0 0 80 100" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={anchorGlyph} />Anchor</span>
        <span class="glass atag"><span class="wave" aria-hidden="true"></span>Hold the tag to unanchor</span>
      </div>
    </div>
    <div class="fade"></div>

    <!-- `HalfTabBar`: the app's own floating capsule, an icon over a label per side. -->
    <div class="tabbar glass" role="tablist" aria-label="Rules or the Anchor" data-tabbar>
      {HALVES.map((h, i) => (
        <button
          type="button"
          class="half"
          role="tab"
          id={`hero-half-${h.key}`}
          data-half={h.key}
          aria-controls="hero-panel"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="hicon" set:html={h.icon} />
          <span class="htitle">{h.title}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- The evening on a thread: the band is the window, the sliver its last five minutes. -->
  <div class="controls">
    <div
      class="scrub"
      data-hero-scrub
      role="slider"
      tabindex="0"
      aria-label="Scrub the evening"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="7:59 PM"
      style="--a: 0; --b: 0; --w: 0; --p: 0"
    >
      <span class="strack"></span>
      <span class="sband"></span>
      <span class="swarn"></span>
      <span class="sknob"></span>
    </div>
  </div>

  <p class="caption cue" data-hero-caption>Turn the page: an hourglass, a row, or a drag across the phone. The bar at the bottom is the other half.</p>

  <script type="application/json" data-hero-targets is:inline set:html={JSON.stringify({ targets: DATA, anchor: ANCHOR })}></script>
</div>

<style>
  /* Nothing inside the phone is text to select: a swipe across it turns a page. */
  .phone {
    position: relative; width: min(350px, 100%); height: 672px; margin-inline: auto; overflow: hidden;
    border-radius: 44px; border: 1px solid rgba(255, 255, 255, 0.16); background: var(--ground);
    background-image:
      radial-gradient(ellipse 70% 42% at 28% 104%, rgba(229, 86, 61, 0.6), transparent 62%),
      radial-gradient(ellipse 60% 40% at 90% -4%, rgba(245, 158, 74, 0.14), transparent 60%);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55), 0 0 120px rgba(229, 86, 61, 0.1), inset 0 0 0 1px rgba(0, 0, 0, 0.6);
    padding: 0 16px;
    user-select: none; -webkit-user-select: none;
    -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
  }
  .statusbar { display: flex; justify-content: space-between; align-items: center; padding: 18px 14px 0; font-size: 14px; font-weight: 600; }
  .signal { display: inline-flex; gap: 2px; align-items: flex-end; }
  .signal i { width: 3px; background: var(--cream); border-radius: 1px; }
  .signal i:nth-child(1) { height: 4px; } .signal i:nth-child(2) { height: 6px; } .signal i:nth-child(3) { height: 8px; } .signal i:nth-child(4) { height: 10px; }
  .toolbar { display: flex; align-items: center; justify-content: space-between; padding: 14px 0 0; }
  .toolbar .left { display: flex; gap: 8px; }
  .toolbar .glass { min-height: 36px; cursor: default; }
  .toolbar .glass:hover { transform: none; }

  /* pan-y so a finger dragging up the site still scrolls it; sideways turns the page. */
  .hero-page { display: flex; align-items: center; gap: 16px; padding: 24px 6px 6px; touch-action: pan-y; cursor: grab; }
  .hero-page:active { cursor: grabbing; }
  .hero-page:focus-visible { outline-offset: -2px; border-radius: 18px; }
  .glass-canvas { width: 96px; height: 128px; flex: 0 0 auto; }
  .text { min-width: 0; }
  .name { font-family: var(--display); font-weight: 700; font-size: 26px; letter-spacing: -0.025em; line-height: 1.05; margin-top: 5px; color: var(--cream); }
  .count { font-size: 42px; line-height: 1; margin-top: 8px; color: var(--cream); }
  /* `Line.Big.quiet`: a word where a countdown would be, smaller and stepped back. */
  .count.quiet { font-size: 30px; color: var(--muted); }
  .sub { font-size: 12px; color: var(--muted); margin-top: 8px; }

  .indicator { display: flex; justify-content: center; align-items: center; }
  .indicator[hidden] { display: none; }
  .dot { display: grid; place-items: center; padding: 9px 7px; background: none; border: 0; cursor: pointer; border-radius: 8px; -webkit-appearance: none; appearance: none; }
  .dot canvas { width: 11px; height: 15px; opacity: 0.5; transition: transform 0.25s, opacity 0.25s; }
  .dot[aria-selected='true'] canvas { opacity: 1; transform: scale(1.35); }
  .dot:hover canvas { opacity: 0.85; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .list[hidden] { display: none; }
  .seclabel { padding: 10px 8px 6px; }
  .rows { display: flex; flex-direction: column; overflow: hidden; }
  .row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; width: 100%; text-align: left; background: none; border: 0; border-radius: 0; color: inherit; font: inherit; -webkit-appearance: none; appearance: none; }
  .row + .row { border-top: 1px solid var(--edge); }
  button.row { cursor: pointer; position: relative; transition: background 0.2s var(--ease); }
  button.row:hover { background: rgba(255, 255, 255, 0.05); }
  /* The quiet marker: the row whose page is showing keeps a bar on the rule's own edge. */
  button.row[aria-current='true'] { background: rgba(255, 255, 255, 0.045); }
  button.row[aria-current='true']::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px; border-radius: 0 2px 2px 0; background: var(--ember); }
  .tile { width: 34px; height: 34px; border-radius: 9px; background: var(--c); display: grid; place-items: center; font-family: var(--display); font-weight: 700; font-size: 15px; color: #fff; flex: 0 0 auto; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
  .tile :global(svg) { display: block; width: 21px; height: 21px; }
  .tile.yt :global(svg) { width: 24px; height: 24px; }
  .tile.tt :global(svg) { width: 22px; height: 22px; }
  .tile.tt { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); }
  .tile.ig { background: radial-gradient(circle at 28% 108%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%); }
  .who { display: flex; flex-direction: column; min-width: 0; align-items: flex-start; }
  .n { font-family: var(--display-small); font-weight: 600; font-size: 13.5px; line-height: 1.15; color: var(--cream); }
  .r { font-size: 11.5px; color: var(--muted); margin-top: 2px; }
  .chip { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; font-variant-numeric: tabular-nums; transition: color 0.3s var(--ease); }
  .chip.amber { color: var(--amber); } .chip.grey { color: var(--faint); } .chip.muted { color: var(--muted); } .chip.moss { color: var(--moss); }
  .chip canvas { width: 12px; height: 16px; }
  .fade { position: absolute; left: 0; right: 0; bottom: 0; height: 96px; background: linear-gradient(180deg, transparent, rgba(15, 13, 11, 0.96) 62%); pointer-events: none; }

  /* The Anchor half. One class on the list says whether it is held; the rows follow. */
  .achip { color: var(--faint); }
  .achip .a-held, .anchor-list.held .achip .a-ready { display: none; }
  .anchor-list.held .achip .a-held { display: inline; }
  .anchor-list.held .achip { color: var(--ember); }
  .aact { display: flex; gap: 8px; padding: 14px 4px 0; }
  .aact .glass { min-height: 38px; font-size: 13px; cursor: default; transition: transform 0.25s var(--ease), box-shadow 0.35s var(--ease), background 0.25s var(--ease); }
  .aact .glass:hover { transform: none; }
  .atag, .anchor-list.held .abtn { display: none; }
  .anchor-list.held .atag { display: inline-flex; }
  .anchor-list.tapping .abtn { transform: scale(0.955); box-shadow: 0 0 0 7px rgba(229, 86, 61, 0.2), 0 10px 34px rgba(229, 86, 61, 0.32); }
  .wave { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--ember); border-left-color: transparent; border-bottom-color: transparent; transform: rotate(-45deg); }

  /* `HalfTabBar`: floating over the bottom rather than spanning it, 68 pt a side. */
  .tabbar {
    position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%);
    display: flex; gap: 4px; padding: 5px; min-height: 0; z-index: 2;
  }
  .tabbar:hover { transform: translateX(-50%); background: linear-gradient(160deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05)); }
  .half {
    display: grid; justify-items: center; gap: 3px; width: 68px; padding: 9px 0;
    background: none; border: 0; border-radius: 999px; cursor: pointer; color: var(--muted);
    -webkit-appearance: none; appearance: none; transition: color 0.25s var(--ease);
  }
  .half[aria-selected='true'] { color: var(--amber); }
  .hicon { display: grid; place-items: center; width: 22px; height: 20px; }
  .hicon :global(svg) { width: 19px; height: 19px; }
  .htitle { font-family: var(--body); font-weight: 700; font-size: 10.5px; line-height: 13px; letter-spacing: 0.01em; }

  /* Until it has been used, the two controls say so: the strip breathes and the tab bar rings,
     the second offset from the first. Both stop for good on the first real interaction. */
  @media (prefers-reduced-motion: no-preference) {
    .stack:not(.used) .dot:not([aria-selected='true']) canvas { animation: breathe 2.8s var(--ease) infinite; }
    .stack:not(.used) .dot:nth-child(2) canvas { animation-delay: 0.1s; }
    .stack:not(.used) .dot:nth-child(3) canvas { animation-delay: 0.2s; }
    .stack:not(.used) .dot:nth-child(4) canvas { animation-delay: 0.3s; }
    .stack:not(.used) .tabbar { animation: ring 2.8s var(--ease) 1.4s infinite; }
    .stack:not(.used) .half[aria-selected='false'] { animation: warm 2.8s var(--ease) 1.4s infinite; }
    .anchor-list.tagging .atag { animation: tag 1.15s var(--ease) infinite; }
    @keyframes breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.95; } }
    @keyframes ring { 0%, 58%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 74, 0); } 14% { box-shadow: 0 0 0 0 rgba(245, 158, 74, 0.36); } 44% { box-shadow: 0 0 0 11px rgba(245, 158, 74, 0); } }
    @keyframes warm { 0%, 100% { background: rgba(245, 158, 74, 0); } 34% { background: rgba(245, 158, 74, 0.14); } }
    @keyframes tag { 0%, 100% { box-shadow: 0 0 0 0 rgba(229, 86, 61, 0.5); } 55% { box-shadow: 0 0 0 9px rgba(229, 86, 61, 0); } }
  }

  /* The controls under the phone, outside its tilt. The hero's perspective only reaches its
     own children, so it is repeated here for the phone now that .stack sits between. */
  .stack { perspective: 1800px; }
  .caption {
    max-width: 350px; margin: 14px auto 0; text-align: center;
    font-size: 13px; line-height: 1.45; color: var(--muted); min-height: 38px;
  }
  .caption.cue { color: var(--faint); font-size: 12.5px; }
  .controls { display: flex; justify-content: center; align-items: center; margin-top: 16px; }

  /* pan-y again: the scrubber is the small draggable thing, so the rule goes on it alone. */
  .scrub { position: relative; width: min(300px, 100%); height: 28px; cursor: grab; touch-action: pan-y; }
  .scrub.dragging { cursor: grabbing; }
  .scrub span { position: absolute; top: 12px; height: 4px; pointer-events: none; }
  .strack { left: 0; right: 0; border-radius: 2px; background: rgba(255, 255, 255, 0.12); }
  .sband { left: calc(var(--a) * 1%); width: calc((var(--b) - var(--a)) * 1%); background: rgba(123, 201, 111, 0.55); }
  .swarn { left: calc(var(--w) * 1%); width: calc((var(--b) - var(--w)) * 1%); background: rgba(245, 158, 74, 0.8); }
  .scrub.anchor .sband { background: rgba(229, 86, 61, 0.5); }
  .scrub.anchor .swarn { display: none; }
  .scrub .sknob { top: 6px; height: 16px; width: 16px; margin-left: -8px; left: calc(var(--p) * 1%); border-radius: 50%;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.12));
    border: 1px solid rgba(255, 255, 255, 0.5); box-shadow: 0 3px 10px rgba(0, 0, 0, 0.45); }
  .scrub:hover .sknob, .scrub:focus-visible .sknob { box-shadow: 0 3px 10px rgba(0, 0, 0, 0.45), 0 0 0 5px rgba(245, 158, 74, 0.16); }
  .scrub:focus-visible { outline-offset: 4px; }
</style>

<script>
  import { LivingHourglass, States, blendStates, reduceMotion, type HourglassState } from '../lib/hourglass';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  const stack = root?.closest('.stack') as HTMLElement | null;
  if (root && stack) {
    type TargetData = {
      key: string; name: string; detail: string;
      open?: number; close?: number; budget?: string; opensAt?: string; until?: string;
      spends?: boolean; blocked?: boolean;
    };

    const table = JSON.parse(stack.querySelector('[data-hero-targets]')!.textContent!) as
      { targets: TargetData[]; anchor: { count: number; names: string } };
    const data = table.targets;
    const byKey = Object.fromEntries(data.map((d) => [d.key, d])) as Record<string, TargetData>;
    const HOLDS = table.anchor;

    const canvas = root.querySelector<HTMLCanvasElement>('[data-hero-glass]')!;
    const eyebrowEl = root.querySelector<HTMLElement>('[data-hero-eyebrow]')!;
    const nameEl = root.querySelector<HTMLElement>('[data-hero-name]')!;
    const countEl = root.querySelector<HTMLElement>('[data-hero-count]')!;
    const subEl = root.querySelector<HTMLElement>('[data-hero-sub]')!;
    const textEl = root.querySelector<HTMLElement>('[data-hero-text]')!;
    const clockEl = root.querySelector<HTMLElement>('[data-hero-clock]')!;
    const panel = root.querySelector<HTMLElement>('[data-hero-panel]')!;
    const strip = root.querySelector<HTMLElement>('[data-strip]')!;
    const tabbar = root.querySelector<HTMLElement>('[data-tabbar]')!;
    const todayList = root.querySelector<HTMLElement>('[data-today-list]')!;
    const anchorList = root.querySelector<HTMLElement>('[data-anchor-list]')!;
    const captionEl = stack.querySelector<HTMLElement>('[data-hero-caption]')!;
    const scrub = stack.querySelector<HTMLElement>('[data-hero-scrub]')!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const halfBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-half]'));
    const rowBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-row]'));
    const PAGES = tabs.map((t) => t.dataset.tab!);
    const HOME = PAGES[0];

    // One evening, played ten times faster than life, from 7:59 PM. Instagram's window is
    // 8:00–8:30 with a 30-minute budget spent all the way through it, so the last five minutes
    // carry the budget warning and its glass runs empty as the window closes. The other three
    // are what they are at that hour: YouTube open on an untouched budget, Reddit still an hour
    // off, TikTok blocked with nothing to count.
    const SPEED = 10;
    const LEAD_IN = 60;
    const PRE = LEAD_IN / SPEED, WINDOW = 1800 / SPEED, DONE = 8;
    const CYCLE = PRE + WINDOW + DONE;
    const WARN = 300;
    const DAY = 86400;
    /** The second of the day the loop starts on: a minute of app time before 8:00 PM. */
    const EVENING = 20 * 3600 - LEAD_IN;
    const secondsAt = (t: number) => EVENING + t * SPEED;
    /** One page giving way to the next, and how long the phone waits before taking itself back. */
    const TURN = 380, IDLE = 20000;
    const CUE = 'Turn the page: an hourglass, a row, or a drag across the phone. The bar at the bottom is the other half.';

    const glass = new LivingHourglass(canvas, States.comingSoon(1));
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const pad = (n: number) => String(n).padStart(2, '0');

    const countdown = (seconds: number) => {
      const total = Math.max(0, Math.floor(seconds));
      const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60;
      return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
    };
    /** The status bar's clock: "8:07", from a second of the day. */
    const hhmm = (sec: number) => {
      const h = Math.floor(sec / 3600) % 24;
      return `${h % 12 || 12}:${pad(Math.floor(sec / 60) % 60)}`;
    };
    const clockText = (sec: number) => `${hhmm(sec)} ${Math.floor(sec / 3600) % 24 < 12 ? 'AM' : 'PM'}`;
    const setText = (el: HTMLElement, text: string) => { if (el.textContent !== text) el.textContent = text; };
    const setClass = (el: HTMLElement, cls: string) => { if (el.className !== cls) el.className = cls; };
    const setAttr = (el: Element, name: string, value: string) => { if (el.getAttribute(name) !== value) el.setAttribute(name, value); };

    type Beat = {
      key: string; state: HourglassState; eyebrow: string; color: string;
      name: string; count: string; quiet: boolean; sub: string;
      caption: string; anchorClass: string; chip: string; chipTone: string;
    };

    // MARK: One evening, read off the table

    /** `HomeView.line(now:)`, in TypeScript: the status decides all four lines and the chip. */
    const beatOf = (d: TargetData, t: number): Beat => {
      const base = { name: d.name, caption: '', anchorClass: '', quiet: false };
      if (d.blocked) {
        return { ...base, key: `${d.key}:blocked`, state: States.alwaysBlocked, eyebrow: 'Always blocked',
          color: 'muted', count: 'all day', quiet: true, sub: d.detail, chip: 'all day', chipTone: 'grey' };
      }
      const s = secondsAt(t), open = d.open! * 60, close = d.close! * 60;
      if (s < open) {
        const to = open - s;
        return { ...base, key: `${d.key}:pre`, state: States.comingSoon(to / 60), eyebrow: 'Next window',
          color: 'amber', count: countdown(to), sub: `opens at ${d.opensAt} · ${d.budget} a day`,
          chip: d.opensAt!, chipTone: 'amber' };
      }
      if (s < close) {
        const left = close - s;
        // Only the app tonight's half hour goes into can run its budget down to the warning.
        const warned = !!d.spends && left <= WARN;
        return { ...base, key: `${d.key}:${warned ? 'warn' : 'open'}`,
          state: States.open(left / (close - open), warned),
          eyebrow: warned ? 'Open now · 5 min left' : `Open now · until ${d.until}`,
          color: warned ? 'amber' : 'moss', count: countdown(left),
          sub: warned ? `${d.budget} budget · under 5 min left` : `${d.budget} budget today`,
          chip: warned ? '5 min' : 'open', chipTone: warned ? 'amber' : 'moss' };
      }
      const to = open + DAY - s;
      return { ...base, key: `${d.key}:done`, state: States.doneForToday, eyebrow: 'Next window',
        color: 'amber', count: countdown(to), sub: `opens tomorrow ${d.opensAt} · ${d.budget} a day`,
        chip: 'tomorrow', chipTone: 'muted' };
    };

    // MARK: The Anchor, walked through

    const STEPS = [
      { key: 'ready', secs: 3.4 }, { key: 'tap', secs: 1.2 }, { key: 'held', secs: 5.4 },
      { key: 'tag', secs: 2.8 }, { key: 'freed', secs: 2.2 },
    ];
    const ENDS: number[] = [];
    STEPS.reduce((n, s) => { ENDS.push(n + s.secs); return n + s.secs; }, 0);
    const ANCHOR_CYCLE = ENDS[ENDS.length - 1];
    /** How long the phone has been held: the tap landed when that step ended. */
    const heldSince = (t: number) => (t - ENDS[0]) * SPEED;
    const APPS = `${HOLDS.count} apps`;

    /** `evening` is the clock the status bar is showing, so "since" is a time the phone has
        actually been on rather than a number typed into the copy. */
    const anchorBeat = (t: number, evening: number): Beat => {
      let i = 0;
      while (i < ENDS.length - 1 && t >= ENDS[i]) i++;
      const base = { name: 'Anchor', count: APPS, quiet: false, chip: '', chipTone: '' };
      switch (STEPS[i].key) {
        case 'ready':
          return {
            ...base, key: 'a-ready', state: States.open(0.62), eyebrow: 'Not anchored', color: 'moss',
            sub: `${APPS}, one switch`, anchorClass: '', quiet: true,
            caption: 'A second list, separate from the rules: the apps you want gone all at once.',
          };
        case 'tap':
          return {
            ...base, key: 'a-tap', state: States.anchored, eyebrow: 'Anchoring…', color: 'ember',
            sub: 'Holding every app in the list', anchorClass: 'tapping', quiet: true,
            caption: 'One tap, from anywhere. No confirmation and no countdown.',
          };
        case 'held':
          return {
            ...base, key: 'a-held', state: States.anchored, color: 'ember',
            eyebrow: `Anchored · since ${clockText(secondsAt(evening) - heldSince(t))}`,
            count: countdown(heldSince(t)), sub: HOLDS.names, anchorClass: 'held',
            caption: 'Every app in the list is held, and the glass stops mid-pour.',
          };
        case 'tag':
          return {
            ...base, key: 'a-tag', state: States.anchored, eyebrow: 'Hold your phone to the tag', color: 'ember',
            count: countdown(heldSince(t)), sub: 'The only thing that ends it', anchorClass: 'held tagging',
            caption: 'Only the NFC tag you paired unlocks it. Leave the tag at home and the phone stays anchored until you are back.',
          };
        default:
          return {
            ...base, key: 'a-freed', state: States.open(0.62), eyebrow: 'Unanchored', color: 'moss',
            sub: 'Back to today’s rules', anchorClass: '', quiet: true,
            caption: 'Tag tapped. Today’s windows and budgets take over again.',
          };
      }
    };

    // MARK: The two clocks

    type Clock = 'today' | 'anchor';
    const cycleOf = (c: Clock) => (c === 'today' ? CYCLE : ANCHOR_CYCLE);
    /** Where each clock's loop began, so leaving the evening does not restart it. */
    const origin: Record<Clock, number> = { today: performance.now(), anchor: performance.now() };
    /** The demo-second a clock is being held at, while the scrubber has hold of it. */
    const held: Partial<Record<Clock, number>> = {};
    const wrapT = (t: number, c: Clock) => ((t % cycleOf(c)) + cycleOf(c)) % cycleOf(c);
    const clock = (now: number, c: Clock) => held[c] ?? wrapT((now - origin[c]) / 1000, c);
    const putClock = (c: Clock, t: number) => { origin[c] = performance.now() - wrapT(t, c) * 1000; };
    const letClockGo = (c: Clock) => {
      const at = held[c];
      if (at === undefined) return;
      delete held[c];
      putClock(c, at);
    };

    // MARK: The two halves, and the pager inside Rules

    type Half = 'rules' | 'anchor';
    let half: Half = 'rules';
    /** Which app the strip and the rows call current. */
    let selected = HOME;
    /** Mid-turn only: `page` is on its way out and `peek` on its way in, `p` of the way there. */
    let page = HOME;
    let peek: string | null = null;
    let p = 0, dir = 1;
    let anim: { from: number; to: number; at: number; ms: number } | null = null;
    let drag: { id: number; x: number; y: number; on: boolean } | null = null;
    let touchedAt = 0;
    let lastSecond = -1;
    const touched = () => { touchedAt = performance.now(); };
    /** A real interaction, as opposed to a pointer crossing the page: it ends the invitation. */
    const used = () => { touched(); stack.classList.add('used'); };
    /** A keyboard is still on it. A mouse click leaves focus behind; that is not watching. */
    const watching = () => { try { return !!stack.querySelector(':focus-visible'); } catch { return false; } };
    const indexOf = (key: string) => PAGES.indexOf(key);
    const clockNow = (): Clock => (half === 'anchor' ? 'anchor' : 'today');

    /** The scrubber's window band, with the last five minutes picked out. */
    const setMarks = (c: Clock) => {
      const pct = (t: number) => clamp((t / cycleOf(c)) * 100, 0, 100);
      if (c === 'anchor') {
        scrub.style.setProperty('--a', String(pct(ENDS[1])));
        scrub.style.setProperty('--b', String(pct(ENDS[3])));
        scrub.style.setProperty('--w', String(pct(ENDS[3])));
        return;
      }
      scrub.style.setProperty('--a', String(pct(PRE)));
      scrub.style.setProperty('--b', String(pct(PRE + WINDOW)));
      scrub.style.setProperty('--w', String(pct(PRE + WINDOW - WARN / SPEED)));
    };

    const sync = () => {
      const anchoring = half === 'anchor';
      for (const tab of tabs) {
        setAttr(tab, 'aria-selected', String(!anchoring && tab.dataset.tab === selected));
        tab.tabIndex = tab.dataset.tab === selected ? 0 : -1;
      }
      for (const row of rowBtns) setAttr(row, 'aria-current', String(!anchoring && row.dataset.row === selected));
      for (const btn of halfBtns) {
        const on = btn.dataset.half === half;
        setAttr(btn, 'aria-selected', String(on));
        btn.tabIndex = on ? 0 : -1;
      }
      setAttr(panel, 'aria-labelledby', anchoring ? 'hero-half-anchor' : `hero-tab-${selected}`);
      if (strip.hidden !== anchoring) strip.hidden = anchoring;
      setAttr(scrub, 'aria-label', anchoring ? 'Scrub the Anchor walkthrough' : 'Scrub the evening');
      scrub.classList.toggle('anchor', anchoring);
      setMarks(clockNow());
      // The once-a-second lines are a second stale the moment the page changes under them.
      lastSecond = -1;
    };

    const settle = () => {
      if (anim && anim.to >= 1 && peek) page = peek;
      peek = null; p = 0; anim = null;
    };

    /** Turns to `key`. The strip and rows follow at once; the page takes `TURN` to arrive. */
    const goTo = (key: string, toward = 0) => {
      settle();
      if (half === 'anchor') { half = 'rules'; page = key; selected = key; sync(); return; }
      if (key === selected && key === page) return;
      selected = key;
      sync();
      if (key === page) return;
      dir = toward || (indexOf(key) > indexOf(page) ? 1 : -1);
      peek = key;
      if (reduceMotion()) { page = key; peek = null; return; }
      anim = { from: 0, to: 1, at: performance.now(), ms: TURN };
    };

    const setHalf = (next: Half) => {
      if (next === half) return;
      settle();
      half = next;
      if (next === 'anchor') origin.anchor = performance.now();
      sync();
    };

    /** What the scrubber says out loud: the evening's clock, or the step being walked through. */
    const SAID: Record<string, string> = {
      ready: 'not anchored', tap: 'anchoring', held: 'anchored', tag: 'at the tag', freed: 'unanchored',
    };
    const scrubText = (c: Clock, t: number) => {
      if (c === 'anchor') {
        let i = 0;
        while (i < ENDS.length - 1 && t >= ENDS[i]) i++;
        return SAID[STEPS[i].key];
      }
      return clockText(secondsAt(t));
    };

    // MARK: The glasses under the page

    const dotGlass: Record<string, LivingHourglass> = {};
    for (const tab of tabs) {
      const key = tab.dataset.tab!;
      dotGlass[key] = new LivingHourglass(tab.querySelector<HTMLCanvasElement>('canvas')!, beatOf(byKey[key], 0).state, { still: true });
    }
    const rowGlass: Record<string, LivingHourglass> = {};
    const rowChip: Record<string, HTMLElement> = {};
    const rowText: Record<string, HTMLElement> = {};
    for (const row of rowBtns) {
      const key = row.dataset.row!;
      rowGlass[key] = new LivingHourglass(row.querySelector<HTMLCanvasElement>('canvas')!, beatOf(byKey[key], 0).state, { still: true });
      rowChip[key] = row.querySelector<HTMLElement>('[data-row-chip]')!;
      rowText[key] = row.querySelector<HTMLElement>('[data-row-text]')!;
    }
    const sigOf = (b: Beat) => `${b.key}:${b.state.sandLevel.toFixed(2)}:${b.state.moundLevel.toFixed(2)}`;
    const lastSig: Record<string, string> = {};

    // MARK: Everything the clock drives

    let lastKey = '';
    let from: HourglassState | null = null;
    let changedAt = 0;

    const beatFor = (key: string, now: number) =>
      key === 'anchor'
        ? anchorBeat(clock(now, 'anchor'), clock(now, 'today'))
        : beatOf(byKey[key], clock(now, 'today'));

    const render = (now: number) => {
      if (anim) {
        const k = clamp((now - anim.at) / anim.ms, 0, 1);
        p = anim.from + (anim.to - anim.from) * (1 - (1 - k) ** 3);
        if (k >= 1) { settle(); from = null; }
      }
      // The page on screen swaps at the halfway point, where the words are invisible anyway.
      const turning = !!peek && half === 'rules';
      const shownKey = half === 'anchor' ? 'anchor' : turning && p >= 0.5 ? peek! : page;
      const b = beatFor(shownKey, now);

      // The glass does not swap: it blends the page that is leaving into the one arriving,
      // and, when neither is moving, the state it is settling into.
      let target = b.state;
      if (turning) target = blendStates(beatFor(page, now).state, beatFor(peek!, now).state, p);
      if (b.key !== lastKey) {
        from = lastKey ? glass.state : null;
        changedAt = now;
        lastKey = b.key;
      }
      const k = from && !turning ? (now - changedAt) / 800 : 1;
      glass.set(from && k < 1 ? blendStates(from, target, k) : target);
      const shown = glass.state;

      const fold = p < 0.5 ? p : p - 1;
      textEl.style.transform = `translateX(${(-dir * fold * 40).toFixed(1)}px)`;
      textEl.style.opacity = turning ? Math.abs(p - 0.5) * 2 + '' : '1';

      setText(eyebrowEl, b.eyebrow);
      setClass(eyebrowEl, `eyebrow ${b.color}`);
      setText(nameEl, b.name);
      setText(countEl, b.count);
      setClass(countEl, b.quiet ? 'count mono quiet' : 'count mono');
      setText(subEl, b.sub);
      setClass(anchorList, `list anchor-list ${b.anchorClass}`.trimEnd());

      const anchoring = half === 'anchor';
      if (todayList.hidden !== anchoring) todayList.hidden = anchoring;
      if (anchorList.hidden === anchoring) anchorList.hidden = !anchoring;
      if (anchoring) { setText(captionEl, b.caption); setClass(captionEl, 'caption'); }
      else { setText(captionEl, CUE); setClass(captionEl, 'caption cue'); }

      // The scrubber, the status bar and the eight small glasses only move once a second.
      const c = clockNow();
      const at = clock(now, c);
      scrub.style.setProperty('--p', String((at / cycleOf(c)) * 100));
      const second = Math.floor(now / 1000);
      if (second !== lastSecond) {
        lastSecond = second;
        const evening = clock(now, 'today');
        setText(clockEl, hhmm(secondsAt(evening)));
        setAttr(scrub, 'aria-valuenow', String(Math.round((at / cycleOf(c)) * 100)));
        setAttr(scrub, 'aria-valuetext', scrubText(c, at));
        for (const key of PAGES) {
          const rb = beatOf(byKey[key], evening);
          const sig = sigOf(rb);
          if (key === shownKey) dotGlass[key].set(shown);
          else if (lastSig[`dot:${key}`] !== sig) { lastSig[`dot:${key}`] = sig; dotGlass[key].set(rb.state); }
          if (lastSig[key] === sig) continue;
          lastSig[key] = sig;
          rowGlass[key].set(rb.state);
          setText(rowText[key], rb.chip);
          setClass(rowChip[key], `chip ${rb.chipTone}`);
        }
      }

      // Left alone for long enough, the phone goes back to playing the evening by itself.
      if (touchedAt && now - touchedAt > IDLE && !anim && !drag && !reduceMotion()
          && (half !== 'rules' || selected !== HOME) && !watching()) {
        touchedAt = 0;
        if (half === 'anchor') { half = 'rules'; page = HOME; selected = HOME; peek = null; p = 0; sync(); }
        else goTo(HOME);
      }
    };

    // MARK: Turning the page

    for (const tab of tabs) {
      tab.addEventListener('click', () => { used(); goTo(tab.dataset.tab!); tab.focus(); });
    }
    for (const row of rowBtns) {
      row.addEventListener('click', () => { used(); goTo(row.dataset.row!); });
    }
    for (const btn of halfBtns) {
      btn.addEventListener('click', () => { used(); setHalf(btn.dataset.half as Half); btn.focus(); });
    }
    strip.addEventListener('keydown', (e) => {
      const i = indexOf(selected);
      let next = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % PAGES.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + PAGES.length) % PAGES.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = PAGES.length - 1;
      if (next < 0) return;
      e.preventDefault();
      used();
      goTo(PAGES[next]);
      tabs[next].focus();
    });
    tabbar.addEventListener('keydown', (e) => {
      if (!['ArrowRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown'].includes(e.key)) return;
      e.preventDefault();
      used();
      const next: Half = half === 'rules' ? 'anchor' : 'rules';
      setHalf(next);
      halfBtns.find((b) => b.dataset.half === next)!.focus();
    });

    // A drag across the page, the way `HeroPager` swipes — and, like it, the ends wrap rather
    // than stop dead. `touch-action: pan-y` leaves the vertical to the browser, so a finger
    // scrolling the site past the phone still scrolls it and arrives here as a cancel.
    panel.addEventListener('pointerdown', (e) => {
      if (anim || half === 'anchor') return;
      touched();
      drag = { id: e.pointerId, x: e.clientX, y: e.clientY, on: false };
      e.preventDefault();
      panel.setPointerCapture(e.pointerId);
    });
    panel.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (!drag.on) {
        if (Math.abs(dx) < 8 || Math.abs(dx) <= Math.abs(dy)) return;
        drag.on = true;
        used();
      }
      touched();
      const width = panel.getBoundingClientRect().width || 300;
      dir = dx < 0 ? 1 : -1;
      peek = PAGES[(indexOf(page) + dir + PAGES.length) % PAGES.length];
      p = clamp(Math.abs(dx) / (width * 0.62), 0, 1);
    });
    const dropped = (commit: boolean) => {
      if (!drag) return;
      const moved = drag.on;
      drag = null;
      if (!moved || !peek) { peek = null; p = 0; return; }
      // Past a third of the way it lands on the next page; short of that it falls back.
      const land = commit && p > 0.34;
      if (land) { selected = peek; sync(); }
      anim = { from: p, to: land ? 1 : 0, at: performance.now(), ms: TURN * (land ? 1 - p : p) + 90 };
    };
    panel.addEventListener('pointerup', () => dropped(true));
    panel.addEventListener('pointercancel', () => dropped(false));

    // MARK: The evening's thread

    const scrubAt = (clientX: number, c: Clock) => {
      const box = scrub.getBoundingClientRect();
      return clamp((clientX - box.left) / Math.max(1, box.width), 0, 1) * cycleOf(c);
    };
    scrub.addEventListener('pointerdown', (e) => {
      used();
      const c = clockNow();
      held[c] = scrubAt(e.clientX, c);
      scrub.classList.add('dragging');
      scrub.setPointerCapture(e.pointerId);
    });
    scrub.addEventListener('pointermove', (e) => {
      if (!scrub.hasPointerCapture(e.pointerId)) return;
      const c = clockNow();
      held[c] = scrubAt(e.clientX, c);
      touched();
    });
    const letGo = () => {
      scrub.classList.remove('dragging');
      letClockGo(clockNow());
    };
    scrub.addEventListener('pointerup', letGo);
    scrub.addEventListener('pointercancel', letGo);
    scrub.addEventListener('keydown', (e) => {
      const c = clockNow();
      const step = e.shiftKey ? cycleOf(c) / 12 : 1;
      const at = clock(performance.now(), c);
      let to: number | null = null;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') to = at - step;
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') to = at + step;
      else if (e.key === 'Home') to = 0;
      else if (e.key === 'End') to = cycleOf(c) - 0.01;
      if (to === null) return;
      e.preventDefault();
      used();
      letClockGo(c);
      putClock(c, to);
    });

    // A pointer moving over it counts as watching, so a page is never pulled out from under
    // someone using it; a cursor merely parked on a control is not mistaken for one.
    stack.addEventListener('pointermove', touched);

    sync();

    // Safari hands out no animation frames for the length of a scroll, which left the countdown
    // frozen until the page came to rest. A timer and the scroll itself keep the clock moving
    // while the frames are away; the frame loop still owns the sand, and marking the time it ran
    // keeps the slower two from doubling up on it.
    let lastRender = 0;
    const loop = (now: number) => {
      requestAnimationFrame(loop);
      lastRender = now;
      render(now);
    };
    const keepTime = () => {
      const now = performance.now();
      if (now - lastRender < 220) return;
      lastRender = now;
      render(now);
    };

    requestAnimationFrame(loop);
    setInterval(keepTime, 250);
    addEventListener('scroll', keepTime, { passive: true });
  }
</script>
