---
import { site } from '../site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap inner">
    <div class="left">
      <div class="brand">
        <canvas width="12" height="16" data-hourglass="doneForToday" data-still aria-hidden="true"></canvas>
        <span>Furlough</span>
      </div>
      <p class="line">Built on Apple's Screen Time API. No third-party code, no server, nothing collected.</p>
      <p class="line faint">© {year} {site.author}</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <div class="eyebrow">App</div>
        <a href="/#how">How it works</a>
        <a href="/#download">Download</a>
        <a href={site.githubURL} rel="noopener">Source on GitHub</a>
      </div>
      <div>
        <div class="eyebrow">Help</div>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy policy</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </nav>
  </div>
</footer>

<style>
  .foot { position: relative; z-index: 1; margin-top: 96px; padding: 40px 0 48px; border-top: 1px solid var(--edge); }
  .inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-family: var(--display-small); font-weight: 600; font-size: 16px; color: var(--cream); }
  .brand canvas { width: 12px; height: 16px; }
  .line { color: var(--muted); font-size: 13.5px; margin-top: 10px; max-width: 42ch; }
  .line.faint { color: var(--faint); margin-top: 6px; }
  .cols { display: flex; gap: 48px; }
  .cols > div { display: flex; flex-direction: column; gap: 8px; }
  .cols .eyebrow { margin-bottom: 4px; }
  .cols a { color: var(--muted); font-size: 14px; }
  .cols a:hover { color: var(--cream); }
</style>
