---
import Base from '../layouts/Base.astro';
import HeroPage from '../components/HeroPage.astro';
import StoreButton from '../components/StoreButton.astro';
import { site } from '../site';

const legend = [
  { state: 'open:0.62', label: 'Open now', note: 'The window drains with the countdown' },
  { state: 'open:0.2:warned', label: '5 minutes left', note: 'The budget warning turns the glass amber' },
  { state: 'comingSoon:4', label: 'Coming soon', note: 'A grain slips through as the window nears' },
  { state: 'doneForToday', label: 'Done for today', note: 'Every grain settled, the glow low' },
  { state: 'usedUp', label: 'Used up', note: 'The budget spent: ember, still' },
  { state: 'alwaysBlocked', label: 'Always blocked', note: 'A category with no windows' },
  { state: 'unconfigured', label: 'Needs a schedule', note: 'Added, nothing enforced yet' },
  { state: 'anchored', label: 'Anchored', note: 'The stream stopped dead until the tag' },
];

// The four tiers from Shared/Core/Utility.swift, with the multiplier each one puts on the
// delay and the line the rule editor prints under the chip.
const tiers = [
  { label: 'Essential', tone: 'moss', multiplier: 0.25 },
  { label: 'Useful', tone: 'cream', multiplier: 1 },
  { label: 'Idle', tone: 'amber', multiplier: 2 },
  { label: 'Hazard', tone: 'ember', multiplier: 4 },
];
---

<Base>
  <!-- Hero -->
  <section class="hero wrap">
    <div class="hero-text" data-reveal>
      <div class="eyebrow amber">Furlough · for iPhone</div>
      <h1 class="display">No unblock button.</h1>
      <p class="lede">
        Two ways to put an app out of reach, and neither has a button that hands it back. Give apps a daily budget and the hours they're allowed, where the only way to loosen a rule is to wait. Or anchor the phone in one tap, and lift it only with an NFC tag you left somewhere else.
      </p>
      <div class="actions">
        <StoreButton />
        <a class="glass large" href="#how">How it works</a>
      </div>
      <p class="fine faint">iOS 18 or later, and a Mac app that locks with it. Built on Apple's Screen Time API. Nothing collected.</p>
    </div>
    <div class="hero-demo" data-reveal style="--d: .15s">
      <HeroPage />
    </div>
  </section>

  <!-- The two halves. Furlough is both, and the page used to introduce only the first. -->
  <section class="wrap idea" id="how">
    <div class="halves">
      <a class="half card" href="#budgets" data-reveal>
        <canvas class="hmark" width="54" height="72" data-hourglass="open:0.45" data-still aria-hidden="true"></canvas>
        <div class="eyebrow amber">The everyday half</div>
        <h3 class="display">Rules</h3>
        <p>Pick apps, categories and websites from Apple's own picker. Give each a daily budget in minutes and, if you want, the hours it's allowed. Tightening is instant; anything that gives you back time waits a delay you set in advance.</p>
        <span class="more">Budgets, windows and the delay &rsaquo;</span>
      </a>
      <a class="half card" href="#anchor" data-reveal style="--d: .1s">
        <svg class="hmark hmark-anchor" viewBox="0 0 80 100" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="40" cy="15" r="10.5"/><path d="M40 26v56M17 38h46M12 58c0 16 12 26 28 26s28-10 28-26"/><path d="M7 41L2 59l16 9zM73 41l5 18-16 9z" fill="currentColor" stroke-width="2"/></svg>
        <div class="eyebrow ember">The other half</div>
        <h3 class="display">The Anchor</h3>
        <p>A second list you lock in one tap, or turn inside out so the whole phone goes. No delay, no timer, no code. The only thing that lifts it is holding your phone to an NFC tag you paired and left somewhere else.</p>
        <span class="more">How the Anchor works &rsaquo;</span>
      </a>
    </div>
    <p class="fine faint centered">Use either on its own. Neither one needs the other.</p>
  </section>

  <!-- The Anchor -->
  <section class="wrap feature" id="anchor">
    <div class="copy" data-reveal>
      <div class="eyebrow ember">The Anchor</div>
      <h2 class="display">Locked till you tap the tag.</h2>
      <p class="lede">A second list of apps you lock in one tap, from anywhere. The only thing that unlocks it is holding your phone to an NFC tag you paired. Leave the tag at home and your phone stays anchored until you're back.</p>
    </div>
    <div class="demo" data-reveal style="--d: .1s">
      <div class="card anchor anchored" data-anchor>
        <div class="ahero">
          <canvas class="aglass" width="84" height="112" data-anchor-glass aria-hidden="true"></canvas>
          <div class="text">
            <div class="eyebrow ember" data-anchor-eyebrow>Anchored · since 6:12 PM</div>
            <div class="name">Anchor</div>
            <div class="count mono" data-anchor-count>2:14:09</div>
            <div class="sub" data-anchor-sub>Instagram, Safari, YouTube +3</div>
          </div>
        </div>
        <div class="aactions">
          <button type="button" class="glass prominent alock" data-anchor-lock>
            <svg viewBox="0 0 80 100" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="40" cy="15" r="10.5"/><path d="M40 26v56M17 38h46M12 58c0 16 12 26 28 26s28-10 28-26"/><path d="M7 41L2 59l16 9zM73 41l5 18-16 9z" fill="currentColor" stroke-width="2"/></svg>
            Anchor
          </button>
          <button type="button" class="glass atag" data-anchor-tag>
            <span class="hold" aria-hidden="true"></span>
            <span class="wave" aria-hidden="true"></span>
            Hold the tag to unanchor
          </button>
        </div>
      </div>
      <p class="cue" data-anchor-cue>Hold that button down, the way you'd hold the phone against the tag.</p>
    </div>
  </section>

  <!-- Budgets -->
  <section class="wrap feature flip" id="budgets">
    <div class="copy" data-reveal>
      <div class="eyebrow amber">Budgets</div>
      <h2 class="display">Thirty minutes. Then it's gone.</h2>
      <p class="lede">Every app gets a daily budget, counted across all its windows and spent whenever it's in front. Five minutes before it runs out you get a warning. At zero, iOS shields the app until midnight.</p>
    </div>
    <div class="demo" data-reveal style="--d: .1s">
      <div class="card budget">
        <div class="eyebrow">Daily budget</div>
        <div class="value"><span class="mono big" data-budget-value>30</span><span class="eyebrow unit">min</span></div>
        <div class="hint" data-budget-hint>across all windows</div>
        <!-- The track is piecewise-linear between the ticks, exactly like the app's own
             BudgetSlider, so the sub-hour range everyone actually uses gets half the width. -->
        <div
          class="slider"
          data-budget-slider
          role="slider"
          tabindex="0"
          aria-label="Daily budget"
          aria-valuemin="5"
          aria-valuemax="240"
          aria-valuenow="30"
          aria-valuetext="30 min a day"
          style="--p: 25"
        >
          <div class="track"></div>
          <div class="fill"></div>
          <div class="knob"></div>
          <div class="ticks">
            <span style="left: 0%">5</span><span style="left: 25%">30</span><span style="left: 50%">60</span><span style="left: 75%">120</span><span style="left: 100%">240</span>
          </div>
        </div>
      </div>
      <p class="cue">Drag it. Five minutes to four hours, in steps of five.</p>
    </div>
  </section>

  <!-- Windows -->
  <section class="wrap feature" id="windows">
    <div class="copy" data-reveal>
      <div class="eyebrow amber">Windows</div>
      <h2 class="display">Open only when you said so.</h2>
      <p class="lede">Eight to ten on school nights. Later on weekends. A window can run past midnight, and each one can have its own days. Outside the windows, the app is shielded.</p>
    </div>
    <div class="demo" data-reveal style="--d: .1s">
      <div class="card week" data-week>
        <div class="days">
          <span class="eyebrow">M</span><span class="eyebrow">T</span><span class="eyebrow amber">W</span><span class="eyebrow">T</span><span class="eyebrow">F</span><span class="eyebrow">S</span><span class="eyebrow">S</span>
        </div>
        <div class="grid">
          <div class="gutter mono">
            <span style="top: 0%">12a</span><span style="top: 12.5%">3</span><span style="top: 25%">6</span><span style="top: 37.5%">9</span><span style="top: 50%">12p</span><span style="top: 62.5%">3</span><span style="top: 75%">6</span><span style="top: 87.5%">9</span>
          </div>
          <div class="cols" data-week-cols>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col today"><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 0; --e: 2"><span class="t">12:00</span><span class="x" aria-hidden="true">×</span></div><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
            <div class="col"><div class="w" role="button" tabindex="0" style="--s: 0; --e: 2"><span class="t">12:00</span><span class="x" aria-hidden="true">×</span></div><div class="w" role="button" tabindex="0" style="--s: 20; --e: 24"><span class="t">8:00</span><span class="x" aria-hidden="true">×</span></div></div>
          </div>
        </div>
        <div class="words" data-week-words aria-live="polite">8 PM to midnight on Mon–Fri · midnight to 2 AM and 8 PM to midnight on Sat and Sun</div>
        <div class="wfoot">
          <span class="whint">Drag a window, or its edges. Tap empty track to add one.</span>
          <button type="button" class="glass tiny" data-week-reset>Reset</button>
        </div>
      </div>
      <!-- Cloned for windows added after load, so they carry the same markup as the seven shipped. -->
      <template data-week-template>
        <div class="w" role="button" tabindex="0"><span class="t"></span><span class="x" aria-hidden="true">×</span></div>
      </template>
    </div>
  </section>

  <!-- The delay -->
  <section class="wrap feature flip" id="delay">
    <div class="copy" data-reveal>
      <div class="eyebrow pending">The delay</div>
      <h2 class="display">Loosening waits a day.</h2>
      <p class="lede">A longer window, a bigger budget, removing an app: each waits out a delay you set in advance, and you can cancel it while it does. Apps you mark <strong>Hazard</strong> wait four times as long. Apps you mark <strong>Essential</strong> wait a quarter.</p>
    </div>
    <div class="demo" data-reveal style="--d: .1s">
      <div class="card pending-card" data-delay>
        <div class="eyebrow pending" data-delay-head>Pending · lands in <span class="mono" data-lands>22:41:06</span></div>
        <div class="prow">
          <span class="tile ig"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.6"/><circle cx="12" cy="12" r="4.6"/><circle cx="17.5" cy="6.5" r="1.35" fill="#fff" stroke="none"/></svg></span>
          <span class="who"><span class="n">Instagram</span><span class="r" data-delay-reason>More time, so it waits 1 day</span></span>
        </div>
        <div class="delta">
          <div class="side">
            <div class="eyebrow">Now</div>
            <div class="mono v">30 min</div>
            <div class="small">8:00–8:30 PM</div>
          </div>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          <div class="side then">
            <div class="eyebrow pending">Waiting</div>
            <div class="mono v">60 min</div>
            <div class="small">8:00–9:00 PM</div>
          </div>
        </div>
        <div class="bar" aria-hidden="true"><div class="prog" data-delay-prog></div></div>
        <div class="eyebrow tlabel">What Instagram is worth to you</div>
        <div class="tiers">
          {tiers.map((t) => (
            <button type="button" class="tier" data-tier={t.multiplier} data-tone={t.tone} aria-pressed={t.multiplier === 1 ? 'true' : 'false'}>{t.label}</button>
          ))}
        </div>
        <div class="tsummary" data-delay-summary>Worth having. Nothing breaks if it waits.</div>
        <div class="pactions"><button type="button" class="glass" data-delay-cancel>Cancel</button></div>
      </div>
      <p class="cue">Move the tier and the wait moves with it: six hours to four days.</p>
    </div>
  </section>

  <!-- The shield -->
  <section class="wrap feature" id="shield">
    <div class="copy" data-reveal>
      <div class="eyebrow ember">The shield</div>
      <h2 class="display">Nothing to tap but Close.</h2>
      <p class="lede">The block screen says which app is closed and when it opens next. That is the whole conversation. No snooze, no "one more minute", no code to type. The app can't be deleted while it's shielded, either.</p>
    </div>
    <div class="demo" data-reveal style="--d: .1s">
      <div class="shieldbox shielded" data-shield-box>
        <!-- The Home Screen the shield sits on: one app held, two that aren't in any rule. -->
        <div class="sbhome" data-shield-home-screen>
          <div class="sbar" aria-hidden="true"><span class="mono">9:41</span><span class="sbsig"><i></i><i></i><i></i><i></i></span></div>
          <div class="sbapps">
            <button type="button" class="sbapp held" data-shield-locked>
              <span class="sbwrap">
                <span class="sbicon ig"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.6"/><circle cx="12" cy="12" r="4.6"/><circle cx="17.5" cy="6.5" r="1.35" fill="#fff" stroke="none"/></svg></span>
                <span class="sbbadge"><canvas width="13" height="17" data-hourglass="doneForToday" data-still aria-hidden="true"></canvas></span>
              </span>
              <span class="sblabel">Instagram</span>
            </button>
            <button type="button" class="sbapp" data-shield-app="messages" data-shield-name="Messages">
              <span class="sbwrap">
                <span class="sbicon ms"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M12 4C6.9 4 3 7.2 3 11.2c0 2.2 1.2 4.2 3.1 5.5.1 1.5-.5 2.8-1.8 3.9 2.1-.1 3.9-.8 5.2-1.9.8.2 1.6.3 2.5.3 5.1 0 9-3.2 9-7.8S17.1 4 12 4Z"/></svg></span>
              </span>
              <span class="sblabel">Messages</span>
            </button>
            <button type="button" class="sbapp" data-shield-app="notes" data-shield-name="Notes">
              <span class="sbwrap">
                <span class="sbicon nt"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" fill="#FBCF3B"/><rect width="24" height="5.4" fill="#FFF7E2"/><g stroke="#B98A12" stroke-width="1.4" stroke-linecap="round"><path d="M5 10.4h14M5 14.4h14M5 18.4h9"/></g></svg></span>
              </span>
              <span class="sblabel">Notes</span>
            </button>
          </div>
          <div class="sbdots" aria-hidden="true"><i class="on"></i><i></i></div>
          <div class="hbar" aria-hidden="true"></div>
        </div>

        <!-- Anything outside the rules opens the way it always did. -->
        <div class="avview" data-shield-view>
          <div class="sbar" aria-hidden="true"><span class="mono">9:41</span><span class="sbsig"><i></i><i></i><i></i><i></i></span></div>
          <div class="avpane" data-pane="messages" hidden>
            <div class="avtitle">Messages</div>
            <div class="avrow"><span class="avface" style="--c: #8C6FE0">J</span><span class="avwho"><b>Jules</b><i>Bringing the hitch Saturday</i></span><span class="avwhen">9:12 AM</span></div>
            <div class="avrow"><span class="avface" style="--c: #C2643E">M</span><span class="avwho"><b>Mom</b><i>Call when you get a minute</i></span><span class="avwhen">Yesterday</span></div>
          </div>
          <div class="avpane" data-pane="notes" hidden>
            <div class="avtitle">Notes</div>
            <div class="avnote">
              <b>Saturday</b>
              <span>Trailer hitch from Dave</span>
              <span>Coffee — the good bag</span>
              <span>Call the vet back</span>
            </div>
          </div>
          <button type="button" class="hbtn" data-shield-home aria-label="Back to the Home Screen"><span class="hbar"></span></button>
        </div>

        <div class="shield" data-shield-screen>
          <canvas class="sglass" width="90" height="120" data-hourglass="doneForToday" aria-hidden="true"></canvas>
          <div class="stitle">Instagram opens tomorrow at 8:00 PM</div>
          <div class="ssub">You get 30 min per day.</div>
          <button type="button" class="close" data-shield-close>Close</button>
        </div>
      </div>
      <p class="cue" data-shield-cue>Go on, tap Close. It is the only button on the screen.</p>
    </div>
  </section>

  <!-- Legend -->
  <section class="wrap legend" id="hourglass">
    <div class="head" data-reveal>
      <div class="eyebrow">The living hourglass</div>
      <h2 class="display">One glass, every status.</h2>
      <p class="lede">The top bulb is the window and drains with the countdown. The pile carries the budget: sand while there's plenty, amber after the warning, ember once it's spent. The same glass sits in every row, the widget and the Live Activity.</p>
      <p class="cue left">Point at one, or press it, to watch that state run.</p>
    </div>
    <div class="swatches">
      {legend.map((l, i) => (
        <button type="button" class="swatch" data-swatch aria-pressed="false" data-reveal style={`--d: ${(i % 4) * 0.07}s`}>
          <canvas width="60" height="80" data-hourglass={l.state} data-still aria-hidden="true"></canvas>
          <span class="l"><b>{l.label}</b>{l.note}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Privacy and the way out -->
  <section class="wrap twin" id="trust">
    <div class="card panel" data-reveal>
      <div class="eyebrow moss">Privacy</div>
      <h2 class="display">Furlough collects nothing.</h2>
      <p>No account, no server, no analytics. Nothing leaves your iPhone until you link it to another device, and then only to your own iCloud: the Anchor's state, so your Mac can lock with it, and the names of what you add if you say so. Apple's Screen Time API never even tells Furlough which apps you picked.</p>
      <a class="glass" href="/privacy/">Read the privacy policy</a>
    </div>
    <div class="card panel" data-reveal style="--d: .1s">
      <div class="eyebrow">The way out</div>
      <h2 class="display">There is one escape, and it's Apple's.</h2>
      <p><span class="path">Settings › Screen Time › Apps with Screen Time Access › Furlough › off.</span> It lifts every shield at once. Furlough can't prevent it, and says so on purpose.</p>
      <a class="glass" href="/support/">Support</a>
    </div>
  </section>

  <!-- Download -->
  <section class="wrap download" id="download">
    <div class="card cta" data-reveal>
      <img class="appicon" src="/icon-512.png" width="96" height="96" alt="The Furlough app icon: a glass hourglass with glowing sand" />
      <div class="ctext">
        <h2 class="display">Ready when you are.</h2>
        <p class="lede">Free of accounts, free of servers, and free of an unblock button. It only works if you mean it.</p>
        <div class="cactions">
          <StoreButton />
          <a class="glass large" href={site.macDownloadURL} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4a2 2 0 0 0-2 2v8.5h16V6a2 2 0 0 0-2-2H6zm-.5 2a.5.5 0 0 1 .5-.5h12a.5.5 0 0 1 .5.5v7H5.5V6z"/>
              <path d="M2 16.5h20l-.9 2.1a2 2 0 0 1-1.84 1.22H4.74a2 2 0 0 1-1.84-1.22L2 16.5z"/>
            </svg>
            Download for Mac
          </a>
        </div>
        <p class="fine faint">Signed with a Developer ID and notarized by Apple, v{site.macVersion}. Furlough for Mac is also open source. <a href={site.githubURL} rel="noopener">Build it from GitHub.</a></p>
      </div>
    </div>
  </section>

  <script>
    // Four demos on this page are the real controls rather than pictures of them: the budget
    // slider, the week of windows, the pending change and the Anchor. Each keeps the numbers
    // the app itself would use, so nothing here promises behaviour the phone doesn't have.
    import { LivingHourglass, States, blendStates, type HourglassState } from '../lib/hourglass';

    const two = (n: number) => String(n).padStart(2, '0');
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const setText = (el: HTMLElement, text: string) => { if (el.textContent !== text) el.textContent = text; };
    /** h:mm:ss, with a leading day count once the wait is longer than one. */
    const duration = (seconds: number) => {
      const t = Math.max(0, Math.floor(seconds));
      const d = Math.floor(t / 86400), h = Math.floor((t % 86400) / 3600);
      const m = Math.floor((t % 3600) / 60), s = t % 60;
      return d ? `${d}d ${two(h)}:${two(m)}:${two(s)}` : `${h}:${two(m)}:${two(s)}`;
    };
    /** "8 PM", "8:30 PM", and the two hours everyone names instead of numbering. */
    const clockTime = (hour: number) => {
      const t = ((hour % 24) + 24) % 24;
      if (t === 0) return 'midnight';
      if (t === 12) return 'noon';
      const whole = Math.floor(t);
      const h = whole % 12 === 0 ? 12 : whole % 12;
      const m = Math.round((t - whole) * 60);
      return m ? `${h}:${two(m)} ${t < 12 ? 'AM' : 'PM'}` : `${h} ${t < 12 ? 'AM' : 'PM'}`;
    };
    // Safari hands out no timers or animation frames for the length of a scroll, which leaves
    // a countdown frozen until the page comes to rest. The scroll itself keeps the clocks honest.
    const everySecond = (tick: () => void) => {
      setInterval(tick, 1000);
      addEventListener('scroll', tick, { passive: true });
    };

    // MARK: The budget slider
    //
    // Ported from Furlough/Views/BudgetSlider.swift: the same five stops, the same 5-minute
    // step, and the same piecewise track, so a drag here lands on a figure the app offers.

    const slider = document.querySelector<HTMLElement>('[data-budget-slider]');
    if (slider) {
      const valueEl = document.querySelector<HTMLElement>('[data-budget-value]')!;
      const hintEl = document.querySelector<HTMLElement>('[data-budget-hint]')!;
      const STOPS = [5, 30, 60, 120, 240];
      const STEP = 5;
      const FIRST = STOPS[0], LAST = STOPS[STOPS.length - 1];

      const fractionFor = (value: number) => {
        if (value >= LAST) return 1;
        const v = clamp(value, FIRST, LAST);
        for (let i = 0; i < STOPS.length - 1; i++) {
          const lo = STOPS[i], hi = STOPS[i + 1];
          if (v <= hi) return (i + (v - lo) / (hi - lo)) / (STOPS.length - 1);
        }
        return 1;
      };
      const valueFor = (fraction: number) => {
        const segments = STOPS.length - 1;
        const scaled = clamp(fraction, 0, 1) * segments;
        const i = Math.min(Math.floor(scaled), segments - 1);
        const lo = STOPS[i], hi = STOPS[i + 1];
        return Math.round((lo + (scaled - i) * (hi - lo)) / STEP) * STEP;
      };
      // TimeFormat.budget, so 90 reads the way the app would print it.
      const label = (m: number) => {
        if (m >= 60 && m % 60 === 0) return m === 60 ? '1 hour' : `${m / 60} hours`;
        return m > 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m} min`;
      };

      let minutes = 30;
      const set = (next: number) => {
        const m = clamp(Math.round(next / STEP) * STEP, FIRST, LAST);
        if (m === minutes) return;
        minutes = m;
        slider.style.setProperty('--p', String(fractionFor(m) * 100));
        setText(valueEl, String(m));
        setText(hintEl, m > 60 ? `${label(m)} across all windows` : 'across all windows');
        slider.setAttribute('aria-valuenow', String(m));
        slider.setAttribute('aria-valuetext', `${label(m)} a day`);
      };
      /** Full width: the knob overhangs the ends, so 0 % and 100 % sit under the outer ticks. */
      const valueAt = (clientX: number) => {
        const box = slider.getBoundingClientRect();
        return valueFor((clientX - box.left) / Math.max(1, box.width));
      };

      slider.addEventListener('pointerdown', (e) => {
        slider.setPointerCapture(e.pointerId);
        slider.classList.add('live', 'dragging');
        set(valueAt(e.clientX));
        e.preventDefault();
      });
      slider.addEventListener('pointermove', (e) => {
        if (slider.hasPointerCapture(e.pointerId)) set(valueAt(e.clientX));
      });
      const release = () => slider.classList.remove('dragging');
      slider.addEventListener('pointerup', release);
      slider.addEventListener('pointercancel', release);
      slider.addEventListener('keydown', (e) => {
        const stopPast = (dir: number) =>
          dir > 0
            ? STOPS.find((s) => s > minutes) ?? LAST
            : [...STOPS].reverse().find((s) => s < minutes) ?? FIRST;
        let next: number | null = null;
        switch (e.key) {
          case 'ArrowRight': case 'ArrowUp': next = minutes + STEP; break;
          case 'ArrowLeft': case 'ArrowDown': next = minutes - STEP; break;
          case 'PageUp': next = stopPast(1); break;
          case 'PageDown': next = stopPast(-1); break;
          case 'Home': next = FIRST; break;
          case 'End': next = LAST; break;
        }
        if (next === null) return;
        e.preventDefault();
        slider.classList.add('live');
        set(next);
      });
    }

    // MARK: The week of windows
    //
    // Windows are dragged and resized on the grid, snapped to the half hour, and the sentence
    // underneath is written from whatever ends up on it. No window may run into its neighbour.

    const week = document.querySelector<HTMLElement>('[data-week]');
    if (week) {
      const colsEl = week.querySelector<HTMLElement>('[data-week-cols]')!;
      const cols = Array.from(colsEl.querySelectorAll<HTMLElement>('.col'));
      const wordsEl = week.querySelector<HTMLElement>('[data-week-words]')!;
      const template = document.querySelector<HTMLTemplateElement>('[data-week-template]')!;
      const resetBtn = week.querySelector<HTMLButtonElement>('[data-week-reset]')!;
      const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      const SNAP = 0.5, MIN = 0.5, ADDED = 2;
      const DEFAULT: [number, number][][] = [
        [[20, 24]], [[20, 24]], [[20, 24]], [[20, 24]], [[20, 24]],
        [[0, 2], [20, 24]], [[0, 2], [20, 24]],
      ];

      const snap = (h: number) => Math.round(h / SNAP) * SNAP;
      const startOf = (el: HTMLElement) => Number(el.style.getPropertyValue('--s'));
      const endOf = (el: HTMLElement) => Number(el.style.getPropertyValue('--e'));
      const windowsIn = (day: number) =>
        Array.from(cols[day].querySelectorAll<HTMLElement>('.w')).sort((a, b) => startOf(a) - startOf(b));
      /** The short start the app prints in a row: "8:00", "12:30". */
      const shortTime = (hour: number) => {
        const whole = Math.floor(hour);
        return `${whole % 12 === 0 ? 12 : whole % 12}:${two(Math.round((hour - whole) * 60))}`;
      };

      const place = (el: HTMLElement, day: number, s: number, e: number) => {
        el.style.setProperty('--s', String(s));
        el.style.setProperty('--e', String(e));
        setText(el.querySelector<HTMLElement>('.t')!, shortTime(s));
        el.setAttribute('aria-label',
          `Window, ${clockTime(s)} to ${clockTime(e)} on ${DAYS[day]}. Arrows move it, shift and the arrows resize it, Delete removes it.`);
      };

      const add = (day: number, s: number, e: number, fresh = false) => {
        const el = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        // A window added by hand skips the stagger the seven columns first animate in with.
        if (fresh) el.style.transitionDelay = '0s';
        place(el, day, s, e);
        cols[day].appendChild(el);
        return el;
      };

      // The sentence. Days carrying the same windows are grouped, in the order they're shown.
      const describe = () => {
        const keyed = cols.map((_, day) =>
          windowsIn(day).map((el) => `${startOf(el)}-${endOf(el)}`).join(','));
        const groups: { key: string; days: number[] }[] = [];
        keyed.forEach((key, day) => {
          const last = groups[groups.length - 1];
          if (last && last.key === key) last.days.push(day);
          else groups.push({ key, days: [day] });
        });
        if (groups.length === 1 && groups[0].key === '') {
          return 'No windows at all: the app is shielded every hour of the week.';
        }
        const named = (days: number[]) => {
          if (days.length === 1) return DAYS[days[0]];
          if (days.length === 2) return `${DAYS[days[0]]} and ${DAYS[days[1]]}`;
          return `${DAYS[days[0]]}–${DAYS[days[days.length - 1]]}`;
        };
        return groups.map(({ key, days }) => {
          const when = days.length === 7 ? 'every day' : `on ${named(days)}`;
          if (!key) return `blocked all day ${when}`;
          const spans = key.split(',').map((pair) => {
            const [s, e] = pair.split('-').map(Number);
            return `${clockTime(s)} to ${clockTime(e)}`;
          });
          return `${spans.length > 2 ? spans.join(', ') : spans.join(' and ')} ${when}`;
        }).join(' · ');
      };
      const refresh = () => setText(wordsEl, describe());

      /** How far a window may reach either way before it meets a neighbour. */
      const room = (el: HTMLElement, day: number) => {
        const start = startOf(el);
        let lo = 0, hi = 24;
        for (const other of windowsIn(day)) {
          if (other === el) continue;
          if (endOf(other) <= start) lo = Math.max(lo, endOf(other));
          else hi = Math.min(hi, startOf(other));
        }
        return [lo, hi] as const;
      };

      const dayOf = (el: HTMLElement) => cols.indexOf(el.closest('.col') as HTMLElement);
      const hourAt = (clientY: number) => {
        const box = colsEl.getBoundingClientRect();
        return ((clientY - box.top) / Math.max(1, box.height)) * 24;
      };

      let drag: { el: HTMLElement; day: number; mode: 'move' | 'top' | 'bottom'; grab: number } | null = null;

      const moveTo = (clientY: number) => {
        if (!drag) return;
        const { el, day, mode } = drag;
        const [lo, hi] = room(el, day);
        const hour = hourAt(clientY);
        if (mode === 'move') {
          const span = endOf(el) - startOf(el);
          const s = clamp(snap(hour - drag.grab), lo, hi - span);
          place(el, day, s, s + span);
        } else if (mode === 'top') {
          place(el, day, clamp(snap(hour), lo, endOf(el) - MIN), endOf(el));
        } else {
          place(el, day, startOf(el), clamp(snap(hour), startOf(el) + MIN, hi));
        }
        refresh();
      };

      colsEl.addEventListener('pointerdown', (e) => {
        const target = e.target as HTMLElement;
        const el = target.closest('.w') as HTMLElement | null;
        if (!el) return;
        if (target.classList.contains('x')) {
          const next = windowsIn(dayOf(el)).find((w) => w !== el);
          el.remove();
          refresh();
          next?.focus();
          e.preventDefault();
          return;
        }
        const box = el.getBoundingClientRect();
        const edge = Math.min(9, box.height / 3);
        drag = {
          el,
          day: dayOf(el),
          mode: e.clientY - box.top <= edge ? 'top' : box.bottom - e.clientY <= edge ? 'bottom' : 'move',
          grab: hourAt(e.clientY) - startOf(el),
        };
        el.classList.add('dragging');
        el.focus();
        el.setPointerCapture(e.pointerId);
        e.preventDefault();
      });

      colsEl.addEventListener('pointermove', (e) => { if (drag) moveTo(e.clientY); });
      const drop = () => {
        if (!drag) return;
        drag.el.classList.remove('dragging');
        drag = null;
      };
      colsEl.addEventListener('pointerup', drop);
      colsEl.addEventListener('pointercancel', drop);

      // Empty track adds one. On the click rather than the press, so a finger scrolling the
      // page past the grid doesn't leave a window behind it.
      colsEl.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.w')) return;
        const col = target.closest('.col') as HTMLElement | null;
        if (!col) return;
        const day = cols.indexOf(col);
        const hour = hourAt(e.clientY);
        let lo = 0, hi = 24;
        for (const w of windowsIn(day)) {
          if (endOf(w) <= hour) lo = Math.max(lo, endOf(w));
          else if (startOf(w) >= hour) hi = Math.min(hi, startOf(w));
          else return;
        }
        if (hi - lo < MIN) return;
        const span = Math.min(ADDED, hi - lo);
        const s = clamp(snap(hour - span / 2), lo, hi - span);
        add(day, s, s + span, true).focus();
        refresh();
      });

      colsEl.addEventListener('keydown', (e) => {
        const el = (e.target as HTMLElement).closest('.w') as HTMLElement | null;
        if (!el) return;
        const day = dayOf(el);
        if (e.key === 'Delete' || e.key === 'Backspace') {
          const next = windowsIn(day).find((w) => w !== el);
          el.remove();
          refresh();
          next?.focus();
          e.preventDefault();
          return;
        }
        const step = e.key === 'ArrowUp' ? -SNAP : e.key === 'ArrowDown' ? SNAP : 0;
        if (!step) return;
        e.preventDefault();
        const [lo, hi] = room(el, day);
        const s = startOf(el), span = endOf(el) - s;
        if (e.shiftKey) place(el, day, s, clamp(endOf(el) + step, s + MIN, hi));
        else {
          const moved = clamp(s + step, lo, hi - span);
          place(el, day, moved, moved + span);
        }
        refresh();
      });

      resetBtn.addEventListener('click', () => {
        cols.forEach((col, day) => {
          col.querySelectorAll('.w').forEach((w) => w.remove());
          for (const [s, e] of DEFAULT[day]) add(day, s, e, true);
        });
        refresh();
      });

      // The markup ships the default week; this only gives those seven their labels.
      cols.forEach((_, day) => windowsIn(day).forEach((el) => place(el, day, startOf(el), endOf(el))));
      refresh();
    }

    // MARK: The pending change
    //
    // The tier carries the multiplier from Utility.delayMultiplier, against the 24-hour base
    // delay a new install starts with: six hours for essential, four days for a hazard.

    const delay = document.querySelector<HTMLElement>('[data-delay]');
    if (delay) {
      const headEl = delay.querySelector<HTMLElement>('[data-delay-head]')!;
      const landsEl = delay.querySelector<HTMLElement>('[data-lands]')!;
      const reasonEl = delay.querySelector<HTMLElement>('[data-delay-reason]')!;
      const progEl = delay.querySelector<HTMLElement>('[data-delay-prog]')!;
      const summaryEl = delay.querySelector<HTMLElement>('[data-delay-summary]')!;
      const cancelBtn = delay.querySelector<HTMLButtonElement>('[data-delay-cancel]')!;
      const tierBtns = Array.from(delay.querySelectorAll<HTMLButtonElement>('.tier'));
      // Utility.summary, the line the rule editor prints under the chip.
      const SUMMARY: Record<string, string> = {
        '0.25': "The phone's own job. Blocking it is the risk.",
        '1': 'Worth having. Nothing breaks if it waits.',
        '2': 'Passes the time.',
        '4': 'The reason you installed Furlough.',
      };
      const BASE = 24 * 3600;
      // Far enough in that the bar has moved, and the useful tier reads the 22:41:06 it always did.
      const ELAPSED = 3600 + 18 * 60 + 54;

      let multiplier = 1;
      let cancelled = false;
      const started = Date.now() - ELAPSED * 1000;
      const total = () => BASE * multiplier;
      const waited = () => {
        const hours = Math.round(total() / 3600);
        if (hours % 24 === 0) return hours === 24 ? '1 day' : `${hours / 24} days`;
        return hours === 1 ? '1 hour' : `${hours} hours`;
      };

      const tick = () => {
        if (cancelled) return;
        const left = total() - (Date.now() - started) / 1000;
        setText(landsEl, duration(left));
        progEl.style.width = `${clamp((1 - left / total()) * 100, 0, 100)}%`;
      };
      const paint = () => {
        delay.classList.toggle('cancelled', cancelled);
        setText(reasonEl, cancelled
          ? 'Cancelled while it waited, so nothing changed'
          : `More time, so it waits ${waited()}`);
        setText(cancelBtn, cancelled ? 'Ask again' : 'Cancel');
        if (cancelled) {
          headEl.textContent = 'Nothing pending · the rule is unchanged';
          progEl.style.width = '0%';
        } else {
          headEl.textContent = 'Pending · lands in ';
          headEl.appendChild(landsEl);
          tick();
        }
      };

      for (const btn of tierBtns) {
        btn.addEventListener('click', () => {
          multiplier = Number(btn.dataset.tier);
          for (const other of tierBtns) other.setAttribute('aria-pressed', String(other === btn));
          setText(summaryEl, SUMMARY[btn.dataset.tier!] ?? '');
          paint();
        });
      }
      cancelBtn.addEventListener('click', () => { cancelled = !cancelled; paint(); });

      paint();
      everySecond(tick);
    }

    // MARK: The Anchor card
    //
    // Anchoring is one tap. The way out is holding the phone to the tag, so the button that
    // ends it wants a real hold rather than a click.

    const anchor = document.querySelector<HTMLElement>('[data-anchor]');
    if (anchor) {
      const canvas = anchor.querySelector<HTMLCanvasElement>('[data-anchor-glass]')!;
      const eyebrowEl = anchor.querySelector<HTMLElement>('[data-anchor-eyebrow]')!;
      const countEl = anchor.querySelector<HTMLElement>('[data-anchor-count]')!;
      const subEl = anchor.querySelector<HTMLElement>('[data-anchor-sub]')!;
      const lockBtn = anchor.querySelector<HTMLButtonElement>('[data-anchor-lock]')!;
      const tagBtn = anchor.querySelector<HTMLButtonElement>('[data-anchor-tag]')!;
      const cueEl = document.querySelector<HTMLElement>('[data-anchor-cue]')!;
      const HOLD = 900;
      const HOLD_CUE = "Hold that button down, the way you'd hold the phone against the tag.";
      const TAP_CUE = 'One tap puts all six out of reach. No delay, no countdown, no code.';

      const glass = new LivingHourglass(canvas, States.anchored);
      let anchored = true;
      let since = Date.now() - (2 * 3600 + 14 * 60 + 9) * 1000;
      // The glass crosses between the two states rather than cutting, the way the app's does.
      let from: HourglassState | null = null;
      let changedAt = 0;
      let crossing = 0;

      const target = () => (anchored ? States.anchored : States.open(0.62));
      const step = (now: number) => {
        crossing = 0;
        const k = (now - changedAt) / 700;
        glass.set(from && k < 1 ? blendStates(from, target(), k) : target());
        if (k < 1) crossing = requestAnimationFrame(step);
      };
      const cross = () => {
        from = glass.state;
        changedAt = performance.now();
        if (!crossing) crossing = requestAnimationFrame(step);
      };

      const tick = () => setText(countEl, anchored ? duration((Date.now() - since) / 1000) : '6 apps');
      const paint = () => {
        anchor.classList.toggle('anchored', anchored);
        setText(eyebrowEl, anchored
          ? `Anchored · since ${new Date(since).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`
          : 'Not anchored');
        eyebrowEl.className = anchored ? 'eyebrow ember' : 'eyebrow moss';
        setText(subEl, anchored ? 'Instagram, Safari, YouTube +3' : 'Six apps, one switch');
        setText(cueEl, anchored ? HOLD_CUE : TAP_CUE);
        tick();
      };

      lockBtn.addEventListener('click', () => {
        anchored = true;
        since = Date.now();
        cross();
        paint();
        tagBtn.focus();
      });

      let holding = 0;
      let pressedAt = 0;
      const unanchor = () => {
        anchored = false;
        cross();
        paint();
        lockBtn.focus();
      };
      const endHold = (completed: boolean) => {
        clearTimeout(holding);
        holding = 0;
        tagBtn.classList.remove('holding');
        if (!completed && anchored) setText(cueEl, 'Hold it there — the tag wants a second against the phone.');
      };
      tagBtn.addEventListener('pointerdown', (e) => {
        pressedAt = Date.now();
        tagBtn.classList.add('holding');
        holding = window.setTimeout(() => { endHold(true); unanchor(); }, HOLD);
        tagBtn.setPointerCapture(e.pointerId);
      });
      tagBtn.addEventListener('pointerup', () => endHold(false));
      tagBtn.addEventListener('pointercancel', () => endHold(false));
      // Keyboard and assistive clicks arrive with no pointer behind them; those go straight through.
      tagBtn.addEventListener('click', () => { if (Date.now() - pressedAt > 2000) unanchor(); });

      paint();
      everySecond(tick);
    }

    // MARK: The shield
    //
    // Close is the only button, and all it does is put you back on the Home Screen, where
    // Instagram sits grey under the glass. Open it again and the shield is straight back;
    // the two apps that aren't in a rule open the way they always did.

    const shieldBox = document.querySelector<HTMLElement>('[data-shield-box]');
    if (shieldBox) {
      const cueEl = document.querySelector<HTMLElement>('[data-shield-cue]')!;
      const homeScreen = shieldBox.querySelector<HTMLElement>('[data-shield-home-screen]')!;
      const view = shieldBox.querySelector<HTMLElement>('[data-shield-view]')!;
      const screen = shieldBox.querySelector<HTMLElement>('[data-shield-screen]')!;
      const panes = Array.from(view.querySelectorAll<HTMLElement>('[data-pane]'));

      const HOME_CUE = 'Instagram stays grey until tomorrow at 8:00 PM. Tap it and see; the other two open like always.';

      // `inert` takes the layers that are off screen out of the tab order and off the
      // accessibility tree, while leaving them in place to animate.
      const show = (state: 'shield' | 'home' | 'app') => {
        shieldBox.classList.toggle('shielded', state === 'shield');
        shieldBox.classList.toggle('inapp', state === 'app');
        for (const [el, on] of [[homeScreen, 'home'], [view, 'app'], [screen, 'shield']] as const) {
          if (state === on) el.removeAttribute('inert'); else el.setAttribute('inert', '');
        }
      };
      show('shield');

      const goHome = () => {
        show('home');
        setText(cueEl, HOME_CUE);
      };
      shieldBox.querySelector<HTMLButtonElement>('[data-shield-close]')!.addEventListener('click', goHome);
      view.querySelector<HTMLButtonElement>('[data-shield-home]')!.addEventListener('click', goHome);
      shieldBox.querySelector<HTMLButtonElement>('[data-shield-locked]')!.addEventListener('click', () => {
        show('shield');
        setText(cueEl, 'Straight back. There is no attempt counter to run down, and nothing here hands the app over.');
      });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && shieldBox.classList.contains('inapp')) goHome(); });

      for (const btn of shieldBox.querySelectorAll<HTMLButtonElement>('[data-shield-app]')) {
        btn.addEventListener('click', () => {
          const which = btn.dataset.shieldApp;
          for (const pane of panes) pane.hidden = pane.dataset.pane !== which;
          // The app grows out of its own icon, the way it does on the phone.
          const icon = btn.getBoundingClientRect(), box = shieldBox.getBoundingClientRect();
          view.style.setProperty('--ox', `${((icon.left + icon.width / 2 - box.left) / box.width) * 100}%`);
          view.style.setProperty('--oy', `${((icon.top + icon.height / 2 - box.top) / box.height) * 100}%`);
          show('app');
          setText(cueEl, `${btn.dataset.shieldName} opens like always — only what you put in a rule is held. Tap the bar at the bottom to go back.`);
        });
      }
    }

    // MARK: The legend
    //
    // The eight swatches are drawn still, so they don't all fight for the frame. Point at one
    // and it runs; press it and it keeps running.

    for (const swatch of document.querySelectorAll<HTMLElement>('[data-swatch]')) {
      const canvas = swatch.querySelector<HTMLCanvasElement>('canvas')!;
      // Base's mountHourglasses owns these canvases, and has run by the time anyone points.
      const held = () => swatch.getAttribute('aria-pressed') === 'true';
      const run = (on: boolean) =>
        (canvas as HTMLCanvasElement & { hourglass?: LivingHourglass }).hourglass?.setMotion(on);
      swatch.addEventListener('pointerenter', () => run(true));
      swatch.addEventListener('pointerleave', () => run(held()));
      swatch.addEventListener('focus', () => run(true));
      swatch.addEventListener('blur', () => run(held()));
      swatch.addEventListener('click', () => {
        swatch.setAttribute('aria-pressed', String(!held()));
        run(true);
      });
    }
  </script>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; padding: clamp(32px, 7vh, 88px) 0 clamp(48px, 9vh, 112px); min-height: min(calc(100svh - 64px), 820px); }
  .hero-text .lede { margin-top: 22px; }
  .hero-text h1 { margin-top: 14px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; align-items: center; }
  .fine { font-size: 13px; margin-top: 18px; }
  .hero-demo { perspective: 1800px; }
  .hero-demo :global(.phone) { transform: rotateY(-7deg) rotateX(2.5deg); transform-origin: 60% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-demo :global(.phone) { animation: float 9s ease-in-out infinite; }
    @keyframes float { 0%, 100% { transform: rotateY(-7deg) rotateX(2.5deg) translateY(0); } 50% { transform: rotateY(-7deg) rotateX(2.5deg) translateY(-8px); } }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 40px; min-height: 0; text-align: left; }
    .hero-demo :global(.phone) { transform: none; animation: none; }
  }

  /* The two halves */
  .idea { scroll-margin-top: 80px; }
  .halves { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; align-items: stretch; }
  .half { display: flex; flex-direction: column; padding: 26px 24px 24px; text-decoration: none; transition: border-color 0.2s var(--ease), transform 0.2s var(--ease); }
  .half:hover { text-decoration: none; transform: translateY(-2px); border-color: rgba(255, 255, 255, 0.22); }
  .hmark { width: 40px; height: 54px; margin-bottom: 16px; }
  /* Not `.hmark.anchor`: the Anchor demo card below owns a bare `.anchor` rule whose
     padding would collapse this SVG's viewport to nothing. */
  .hmark-anchor { color: var(--ember); width: 42px; height: 52px; stroke: var(--ember); }
  .half h3 { margin-top: 10px; font-size: clamp(24px, 3vw, 30px); color: var(--cream); }
  .half p { color: var(--muted); font-size: 14.5px; margin-top: 10px; }
