---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import notes from '../../../release-notes.json';

// The same `release-notes.json` the two apps bundle and read through
// `Shared/Core/ReleaseNotes.swift`. Imported rather than copied: a changelog whose two copies
// disagree is worse than no changelog, and this one is a build-time import, so a version
// written for the app is on the site the next time it deploys without anybody remembering to.
//
// The rules for the numbers are README's Versioning section. This page only renders them.
type Kind = 'new' | 'better' | 'fixed';
type Platform = 'both' | 'iphone' | 'mac';
type Channel = 'appstore' | 'testflight' | 'unreleased';

interface Change {
  kind: Kind;
  platform: Platform;
  title: string;
  detail: string;
}

interface Release {
  version: string;
  date: string;
  channel: Channel;
  headline: string;
  lead: string;
  changes: Change[];
}

const releases = notes.versions as Release[];

const kindLabel: Record<Kind, string> = { new: 'New', better: 'Better', fixed: 'Fixed' };
const platformLabel: Record<Platform, string | null> = { both: null, iphone: 'iPhone', mac: 'Mac' };
const channelLabel: Record<Channel, string> = {
  appstore: 'App Store',
  testflight: 'TestFlight',
  unreleased: 'Unreleased',
};

// "11 September 2026", the format the privacy policy's own date already uses. UTC, because the
// file's dates are days rather than moments and a timezone would slide half of them by one.
const day = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

// Said once, at the top, rather than implied by a channel chip nobody reads: none of these are
// on the App Store yet. The moment one is, the entry says App Store and this line goes.
const anyOnTheStore = releases.some((release) => release.channel === 'appstore');
---

<Base
  title="Releases"
  description="What changed in each version of Furlough, newest first: the rules, the Anchor, the iPhone app and the Mac app."
>
  <section class="wrap page">
    <header class="head" data-reveal>
      <canvas class="mark" width="60" height="80" data-hourglass="open:0.85" data-still aria-hidden="true"></canvas>
      <div class="eyebrow amber">Releases</div>
      <h1 class="display">What changed.</h1>
      <p class="sub">Furlough for iPhone and Mac, newest first</p>
    </header>

    {!anyOnTheStore && (
      <p class="note card" data-reveal style="--d: .05s">
        Furlough is not on the App Store yet. Every version below went to TestFlight, and the
        Mac app is built from source. The notes are here from the first build on, so there is a
        record of what changed rather than a page that starts the day the app goes live.
      </p>
    )}

    <div class="releases">
      {releases.map((release, index) => (
        <article class="release" data-reveal style={`--d: ${0.1 + index * 0.05}s`}>
          <div class="stamp">
            <h2 class="number">{release.version}</h2>
            <div class="when">
              <time datetime={release.date}>{day(release.date)}</time>
              <span class="chip channel">{channelLabel[release.channel]}</span>
            </div>
          </div>

          <div class="body card">
            <h3 class="headline">{release.headline}</h3>
            <p class="lead">{release.lead}</p>
            <ul class="changes">
              {release.changes.map((change) => (
                <li class="change">
                  <div class="tags">
                    <span class={`chip kind ${change.kind}`}>{kindLabel[change.kind]}</span>
                    {platformLabel[change.platform] && (
                      <span class="chip where">{platformLabel[change.platform]}</span>
                    )}
                  </div>
                  <h4 class="what">{change.title}</h4>
                  <p class="means">{change.detail}</p>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <p class="tail" data-reveal>
      The same notes are in the apps, under Help &gt; What's new. Both read one file, so neither
      can be more up to date than the other. Anything missing:
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</Base>

<style>
  .page { padding: clamp(24px, 6vh, 64px) 0 0; max-width: 760px; }
  .mark { width: 60px; height: 80px; margin-bottom: 20px; }
  .head h1 { margin-top: 12px; font-size: clamp(34px, 5vw, 56px); }
  .sub { color: var(--faint); font-size: 14px; margin-top: 14px; }

  .note {
    margin-top: 28px; padding: 18px 20px;
    color: var(--muted); font-size: 14.5px; line-height: 1.65; max-width: 64ch;
  }

  .releases { display: grid; gap: 40px; margin-top: 36px; }

  .stamp { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .number {
    font-family: var(--mono); font-size: 20px; letter-spacing: -0.01em;
    color: var(--cream); margin: 0;
  }
  .when { display: flex; align-items: center; gap: 10px; color: var(--faint); font-size: 13px; }

  .chip {
    display: inline-flex; align-items: center; height: 20px; padding: 0 8px;
    border-radius: 999px; border: 1px solid var(--edge);
    font-family: var(--body); font-weight: 700; font-size: 10px;
    letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap;
  }
  .chip.channel { color: var(--faint); }
  .chip.where { color: var(--faint); }
  .chip.kind.new { color: var(--amber); border-color: color-mix(in srgb, var(--amber) 40%, transparent); }
  .chip.kind.better { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 40%, transparent); }
  .chip.kind.fixed { color: var(--ember); border-color: color-mix(in srgb, var(--ember) 40%, transparent); }

  .body { margin-top: 12px; padding: 22px 24px; }
  .headline {
    font-family: var(--display-small); font-weight: 600; font-size: 22px;
    letter-spacing: -0.015em; line-height: 1.2; color: var(--cream); margin: 0;
  }
  .lead { color: var(--muted); font-size: 15px; line-height: 1.6; margin-top: 10px; max-width: 58ch; }

  .changes { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 0; }
  .change { padding: 16px 0; border-top: 1px solid var(--edge); }
  .change:first-child { border-top: 1px solid var(--edge-strong); }
  .change:last-child { padding-bottom: 2px; }
  .tags { display: flex; align-items: center; gap: 6px; }
  .what {
    font-family: var(--display-small); font-weight: 600; font-size: 16px;
    letter-spacing: -0.01em; color: var(--cream); margin: 8px 0 0;
  }
  .means { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin-top: 6px; max-width: 60ch; }

  .tail { color: var(--faint); font-size: 14px; line-height: 1.65; margin-top: 40px; max-width: 62ch; }

  @media (max-width: 520px) {
    .stamp { align-items: flex-start; }
    .body { padding: 18px 18px; }
  }
</style>
