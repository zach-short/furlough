---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

// The hub the header points at. Support and Privacy keep their own top-level URLs, because
// those two are what the App Store listing links to and those links must not move; this page
// gathers them so the header can carry one word instead of three.
const topics = [
  {
    href: '/help/windows-and-budgets/',
    eyebrow: 'The rules',
    title: 'Windows and budgets',
    blurb: 'The hours an app is allowed, the minutes a day it gets, and what Screen Time will accept.',
  },
  {
    href: '/help/apps-and-websites/',
    eyebrow: 'The rules',
    title: 'Apps and websites',
    blurb: 'What Furlough can hold, and why a typed website and a picked one are not the same thing.',
  },
  {
    href: '/help/the-anchor/',
    eyebrow: 'The Anchor',
    title: 'Using the Anchor',
    blurb: 'The one-tap lock: what it holds, what freezes while it is on, and the one thing that lifts it.',
  },
  {
    href: '/help/nfc-tags/',
    eyebrow: 'The Anchor',
    title: 'NFC tags',
    blurb: 'Which tag to buy, what you may already own, how a tag is read on iPhone, and why the Mac has no Anchor.',
  },
  {
    href: '/help/outside-the-app/',
    eyebrow: 'Beyond the rules',
    title: 'Outside the app',
    blurb: 'Notifications, the shield, the Live Activity, the widget, and the What\'s Open shortcut.',
  },
  {
    href: '/support/',
    eyebrow: 'Support',
    title: 'If something gets stuck',
    blurb: 'How enforcement works, what to try when a shield will not lift, and the one way out.',
  },
  {
    href: '/help/about/',
    eyebrow: 'About',
    title: 'About Furlough',
    blurb: 'What it is built on, what stays on the phone, and how the setup file works.',
  },
  {
    href: '/privacy/',
    eyebrow: 'Privacy',
    title: 'Privacy policy',
    blurb: 'Furlough collects nothing. No account, no server, no analytics, no networking code at all.',
  },
];
---

<Base title="Help" description="How windows and budgets work, what Furlough can hold, using the Anchor and sourcing a tag, and what Furlough keeps.">
  <section class="wrap page">
    <header class="head" data-reveal>
      <div class="eyebrow amber">Help</div>
      <h1 class="display">The short answers.</h1>
      <p class="sub">Furlough for iPhone and Mac</p>
    </header>

    <nav class="topics" aria-label="Help topics" data-reveal style="--d: .1s">
      {topics.map((topic) => (
        <a class="card topic" href={topic.href}>
          <div class="eyebrow muted">{topic.eyebrow}</div>
          <h2 class="name">{topic.title}</h2>
          <p>{topic.blurb}</p>
        </a>
      ))}
    </nav>

    <p class="tail" data-reveal style="--d: .2s">
      Two things are not here, because only your own phone can answer them: how long a loosening
      waits, which depends on your delay and the app's tier, and what to do the moment a shield
      will not lift. Both live in the app behind the question mark on the home screen.
      Anything else: <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</Base>

<style>
  .page { padding: clamp(24px, 6vh, 64px) 0 0; max-width: 760px; }
  .head h1 { margin-top: 12px; font-size: clamp(34px, 5vw, 56px); }
  .sub { color: var(--faint); font-size: 14px; margin-top: 14px; }
  .topics { display: grid; gap: 12px; margin-top: 32px; }
  .topic {
    display: block; padding: 22px 24px; color: inherit; text-decoration: none;
    transition: transform 0.25s var(--ease), background 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .topic:hover {
    text-decoration: none; transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.09); border-color: var(--edge-strong);
  }
  .topic .name {
    font-family: var(--display-small); font-weight: 600; font-size: 22px;
    letter-spacing: -0.015em; line-height: 1.2; color: var(--cream); margin: 6px 0 0;
  }
  .topic p { color: var(--muted); font-size: 15px; line-height: 1.6; margin-top: 8px; max-width: 54ch; }
  .tail { color: var(--faint); font-size: 14px; line-height: 1.65; margin-top: 28px; max-width: 62ch; }
</style>
